---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalCard from '../../components/cards/HorizontalCard.astro';
import FeatureCard from '../../components/cards/FeatureCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Divider from '../../components/ui/Divider.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { siteConfig } from '../../config/site';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// Filter posts that are guides
const guidePosts = allPosts.filter(p => p.data.category === 'clients' || p.data.category === 'beginner' || p.data.category === 'routing');
const sortedGuides = guidePosts.sort((a, b) => {
  const dateA = new Date(a.data.updatedDate || a.data.pubDate).getTime();
  const dateB = new Date(b.data.updatedDate || b.data.pubDate).getTime();
  return dateB - dateA;
});

const featuredGuide = sortedGuides.find(p => p.id === 'airport-ladder-beginner-selection-guide') || sortedGuides[0];
const beginnerGuides = sortedGuides.filter(g => g.data.difficulty === 'Beginner');
const intermediateGuides = sortedGuides.filter(g => g.data.difficulty === 'Intermediate');
const advancedGuides = sortedGuides.filter(g => g.data.difficulty === 'Advanced');

const breadcrumbs = [
  { name: '首页', item: '/' },
  { name: '实战配置教程', item: '/guides/' }
];

const guidesSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '2026 客户端与分流实战配置教程中心',
    description: '涵盖 Clash Verge Rev、Shadowrocket、Sing-box、OpenWrt 旁路由与 DNS 防泄漏全流程实战指南。',
    url: `${siteConfig.url}/guides/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: sortedGuides.slice(0, 12).map((g, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        url: `${siteConfig.url}/articles/${g.id}/`,
        name: g.data.title
      }))
    }
  }
];
---

<BaseLayout
  title={`实战配置教程与机场客户端使用指南 | ${siteConfig.name}`}
  description="系统学习机场梯子选购、Clash Verge Rev / Shadowrocket / v2rayN 安装、Smart DNS 与分流规则优化，支持按新手/中阶/高阶难度筛选。"
  breadcrumbs={breadcrumbs}
  extraSchemas={guidesSchema}
>
  <div class="container guides-page">
    <Breadcrumb items={breadcrumbs} />

    <header class="guides-header" data-reveal>
      <Badge variant="accent">
        <span class="signal-dot"></span>
        实战教程中心 · HANDS-ON GUIDES
      </Badge>
      <h1 class="guides-title">客户端、路由与防泄漏实战教程</h1>
      <p class="guides-desc">
        专注可复现的配置与排错步骤。从新手购入第一家机场梯子，到 Mihomo / Sing-box 脚本调优、MosDNS 双栈防泄漏，按难度梯度快速检索。还没挑好服务商？可先查看 <a href="/airports/" style="color:var(--accent);">2026 优质机场总榜</a>。
      </p>

      <!-- Difficulty Filter Chips (Interactive via Client-side JS) -->
      <div class="filter-chips-bar">
        <button class="diff-chip is-active" data-filter="all">全部教程 ({sortedGuides.length})</button>
        <button class="diff-chip" data-filter="beginner">新手起步 ({beginnerGuides.length})</button>
        <button class="diff-chip" data-filter="intermediate">中阶进阶 ({intermediateGuides.length})</button>
        <button class="diff-chip" data-filter="advanced">高阶极客 ({advancedGuides.length})</button>
      </div>
    </header>

    <!-- Top Featured Guide -->
    {featuredGuide && (
      <section class="featured-guide-sec" data-reveal>
        <h2 style="font-size:1.25rem;font-weight:700;margin:0 0 1rem;color:var(--text);">新手首读 · 推荐核心指南</h2>
        <FeatureCard
          title={featuredGuide.data.title}
          description={featuredGuide.data.description}
          href={`/articles/${featuredGuide.id}/`}
          category={featuredGuide.data.category}
          categoryName={featuredGuide.data.categoryName}
          readingTime={featuredGuide.data.readingTime}
          badgeText="新手推荐"
          indexNum="★"
        />
      </section>
    )}

    <Divider label="全难度实战目录 · 按发布/更新排序" />

    <h2 style="font-size:1.25rem;font-weight:700;margin:0 0 1.25rem;color:var(--text);">全部实战教程（共 {sortedGuides.length} 篇）</h2>

    <!-- All Guides List -->
    <div class="guides-list-container" id="guides-list" data-reveal>
      {sortedGuides.map(guide => (
        <div class="guide-item-wrap" data-difficulty={guide.data.difficulty.toLowerCase()}>
          <HorizontalCard
            title={guide.data.title}
            description={guide.data.description}
            href={`/articles/${guide.id}/`}
            date={guide.data.pubDate}
            category={guide.data.category}
            categoryName={guide.data.categoryName}
            readingTime={guide.data.readingTime}
            difficulty={guide.data.difficulty}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .guides-page {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .guides-header {
    max-width: 820px;
    margin-bottom: 3rem;
  }

  .guides-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .guides-desc {
    font-size: 1.1rem;
    color: var(--text-soft);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .filter-chips-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .diff-chip {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-soft);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .diff-chip:hover,
  .diff-chip.is-active {
    background: rgba(124, 255, 178, 0.12);
    border-color: var(--accent);
    color: var(--accent);
  }

  .featured-guide-sec {
    margin-bottom: 3rem;
  }

  .guides-list-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .guide-item-wrap.is-hidden {
    display: none;
  }
</style>

<script>
  function setupGuideFilters() {
    const chips = document.querySelectorAll('.diff-chip');
    const items = document.querySelectorAll('.guide-item-wrap');

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('is-active'));
        chip.classList.add('is-active');

        const filter = chip.getAttribute('data-filter');

        items.forEach(item => {
          const diff = item.getAttribute('data-difficulty');
          if (filter === 'all' || diff === filter) {
            item.classList.remove('is-hidden');
          } else {
            item.classList.add('is-hidden');
          }
        });
      });
    });
  }

  setupGuideFilters();
  document.addEventListener('astro:page-load', setupGuideFilters);
</script>
