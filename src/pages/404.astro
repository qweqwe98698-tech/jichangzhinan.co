---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`404 - 信号丢失 (Signal Lost) | ${siteConfig.name}`}
  description="找不到目标页面或数据流已断开。"
>
  <div class="container not-found-page">
    <div class="not-found-box flux-card" data-reveal>
      <!-- Broken Orbit Graphic -->
      <div class="broken-orbit-visual">
        <svg viewBox="0 0 300 160" fill="none" class="broken-svg">
          <circle cx="150" cy="80" r="60" stroke="rgba(255, 127, 145, 0.3)" stroke-width="1.5" stroke-dasharray="8 6"/>
          <path d="M 90 80 L 130 80" stroke="#FF7F91" stroke-width="2"/>
          <path d="M 170 80 L 210 80" stroke="rgba(255, 127, 145, 0.4)" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="130" cy="80" r="4" fill="#FF7F91"/>
          <circle cx="170" cy="80" r="4" fill="rgba(255, 127, 145, 0.4)"/>
        </svg>
      </div>

      <div class="error-status">
        <span class="signal-dot" style="background-color: var(--danger); box-shadow: 0 0 10px rgba(255, 127, 145, 0.5);"></span>
        <span class="status-code">SIGNAL LOST // 404</span>
      </div>

      <h1 class="error-title">目标节点或页面不存在</h1>
      <p class="error-desc">
        你所请求的路由可能已被重构、迁移，或输入的 URL 地址存在拼写错误。
      </p>

      <div class="error-actions">
        <Button href="/" variant="primary" size="md">
          返回首页 →
        </Button>
        <button type="button" class="flux-btn btn-secondary btn-md search-trigger-btn">
          搜索知识库
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height) - 200px);
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .not-found-box {
    max-width: 600px;
    width: 100%;
    text-align: center;
    padding: 3.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .broken-orbit-visual {
    width: 220px;
    height: 120px;
    margin-bottom: 1rem;
  }

  .broken-svg {
    width: 100%;
    height: 100%;
  }

  .error-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--danger);
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .error-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .error-desc {
    font-size: 1rem;
    color: var(--text-soft);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 440px;
  }

  .error-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
