---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Badge from '../../components/ui/Badge.astro';
import Divider from '../../components/ui/Divider.astro';
import { deepReviewAirports, airportsData, type AirportItem } from '../../data/airports';
import { airportReviewsMap, type AirportDeepReview } from '../../data/airportReviews';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
  return deepReviewAirports.map((airport) => {
    const review = airportReviewsMap[airport.slug];
    if (!review) {
      throw new Error(`Missing deep review entry in airportReviewsMap for slug: ${airport.slug}`);
    }
    return {
      params: { slug: airport.slug },
      props: { airport, review }
    };
  });
}

interface Props {
  airport: AirportItem;
  review: AirportDeepReview;
}

const { airport, review } = Astro.props;

const evidenceImages =
  airport.evidenceImages && airport.evidenceImages.length > 0
    ? airport.evidenceImages
    : airport.speedtestImage
      ? [
          {
            src: airport.speedtestImage,
            webp: airport.speedtestImage
              .replace('/speedtest/', '/speedtest/webp/')
              .replace(/\.(png|jpe?g)$/i, '.webp'),
            width: 960,
            height: 1200,
            title: `${airport.name} 节点测速实测原图`,
            caption: `${airport.name} ${airport.lineType} 节点实测记录。`,
            alt: `${airport.name}（${airport.lineType}）真实测速截图`,
            testedAt: airport.speedtestDate,
            category: 'speedtest' as const,
            env: '实测测速环境',
            protocol: airport.protocols.join(' / ')
          }
        ]
      : [];

const hasExternalUrl = /^https?:\/\//i.test(airport.officialUrl);
const primaryImage = evidenceImages[0]?.webp || evidenceImages[0]?.src || '/og-cover.png';

const tierLabelMap: Record<AirportItem['tier'], string> = {
  Flagship: '旗舰专线梯队',
  HighValue: '高性价比主力',
  OnDemand: '按量不限时精选',
  Budget: '便宜入门档',
  Enterprise: '企业极速独享'
};

const categoryLabelMap: Record<'speedtest' | 'unlock' | 'isp-matrix', string> = {
  speedtest: '节点测速原图',
  unlock: '流媒体/AI 解锁图',
  'isp-matrix': '三网运营商对照'
};

const relatedBrands = review.relatedSlugs
  .map((slug) => airportsData.find((a) => a.slug === slug))
  .filter((a): a is AirportItem => Boolean(a));

const breadcrumbs = [
  { name: '首页', item: '/' },
  { name: '2026 优质机场总榜 (42家)', item: '/airports/' },
  { name: `${airport.name} 实测评测`, item: `/airports/${airport.slug}/` }
];

const parsedTestDate = /^\d{4}-\d{2}-\d{2}/.test(airport.speedtestDate)
  ? new Date(airport.speedtestDate.slice(0, 10))
  : new Date('2026-08-11');
---

<BaseLayout
  title={review.seoTitle}
  description={review.seoDescription}
  image={primaryImage}
  type="article"
  pubDate={parsedTestDate}
  updatedDate={new Date('2026-11-12')}
  author={siteConfig.author}
  category="机场品牌实测"
  breadcrumbs={breadcrumbs}
  faqs={review.faqs}
>
  <div class="container review-page" data-pagefind-body>
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Summary Header -->
    <header class="review-hero flux-card" data-reveal>
      <div class="review-badges">
        <Badge variant="accent">
          <span class="signal-dot breathing"></span>
          总榜 #{String(airport.rankOrder).padStart(2, '0')} · {airport.isTopTen ? 'TOP 10 主推' : tierLabelMap[airport.tier]}
        </Badge>
        <span class="meta-pill verified">实测证据 · {evidenceImages.length} 张原图</span>
        <span class="meta-pill">{airport.lineType}</span>
        <span class="meta-pill">始于 {airport.openedYear} 年</span>
        <span class="meta-pill">核验时间: {airport.speedtestDate}</span>
      </div>

      <h1 class="review-h1">
        {airport.name} 2026 实测深度评测：测速图表现、AI/流媒体解锁与真实风险
      </h1>

      <p class="review-tagline">{airport.tagline}</p>

      <!-- Direct GEO Answer Box -->
      <div id="quick-verdict" class="verdict-box">
        <div class="verdict-head">
          <span class="verdict-tag">编辑部实测快评 · DIRECT CONCLUSION</span>
          <span class="verdict-score">综合评分 {airport.ratingScore.toFixed(1)} / 10</span>
        </div>
        <p class="verdict-body">{review.quickVerdict}</p>
      </div>

      <!-- 4 Key Specs Strip -->
      <div class="spec-strip">
        <div class="spec-cell">
          <span class="spec-lbl">起步套餐</span>
          <strong class="spec-val highlight">{airport.startingPrice}</strong>
        </div>
        <div class="spec-cell">
          <span class="spec-lbl">起步月流量</span>
          <strong class="spec-val">{airport.monthlyTraffic}</strong>
        </div>
        <div class="spec-cell">
          <span class="spec-lbl">核心接入协议</span>
          <strong class="spec-val">{airport.protocols.join(' · ')}</strong>
        </div>
        <div class="spec-cell">
          <span class="spec-lbl">客户端与订阅</span>
          <strong class="spec-val">
            {airport.supportsThirdPartySub === false ? '仅限官方自研客户端' : '支持第三方通用订阅'}
          </strong>
        </div>
      </div>

      <!-- Promo + Primary Action Row -->
      <div class="hero-action-bar">
        {hasExternalUrl ? (
          <a
            href={airport.officialUrl}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="cta-primary"
          >
            前往 {airport.name} 官网查看最新套餐 ↗
          </a>
        ) : (
          <a href={`/airports/#airport-${airport.id}`} class="cta-secondary">
            查看 {airport.name} 总榜档案 →
          </a>
        )}

        {airport.discountCode && (
          <button
            type="button"
            class="promo-copy-btn"
            data-code={airport.discountCode}
            aria-label={`复制 ${airport.name} 优惠码 ${airport.discountCode}`}
          >
            <span>优惠码:</span>
            <code>{airport.discountCode}</code>
            <span class="copy-status">点击复制</span>
          </button>
        )}

        <a href="/airports/#airport-compare" class="cta-secondary">
          与另外 41 家机场横向 PK →
        </a>
      </div>

      {hasExternalUrl && (
        <p class="disclosure-note">
          商业披露：上述官网直达按钮包含合作推广参数（标注 <code>rel="nofollow sponsored"</code>），不增加您的购买价格；页面内所有实测均值、<code>0B</code>/失效节点、<code>送中(CN)</code> 及无第三方客户端等负面局限均依据原图如实记录。
          {airport.isUrlFormatAlert && '（安全提醒：该品牌直连落地页域名与常见机场面板存在差异，访问时请核对官方客服公告。）'}
        </p>
      )}
    </header>

    <!-- Page TOC -->
    <nav class="review-toc" aria-label="本文测评目录">
      <span class="toc-title">评测目录:</span>
      <a href="#screenshot-breakdown" class="toc-link">01. 测速数据拆解</a>
      <a href="#evidence-showcase" class="toc-link">02. 原始实测图 ({evidenceImages.length}张)</a>
      <a href="#packages-table" class="toc-link">03. 套餐价格表</a>
      <a href="#unlock-client" class="toc-link">04. 解锁与客户端指引</a>
      <a href="#pros-cons" class="toc-link">05. 优缺点与避坑人群</a>
      <a href="#faq" class="toc-link">06. 常见问题 FAQ</a>
      <a href="#related-compare" class="toc-link">07. 竞品交叉对比</a>
    </nav>

    <!-- SECTION 1: Screenshot Breakdown -->
    <section id="screenshot-breakdown" class="review-section" data-reveal>
      <Divider label="01 · 实测维度拆解" />
      <h2 class="sec-h2">{airport.name} 核心测速与稳定性实测拆解</h2>
      <p class="env-callout">
        <strong>测试环境与口径说明：</strong>{review.testEnvironmentSummary}
      </p>

      <div class="breakdown-grid">
        {review.screenshotBreakdown.map((item) => (
          <div class="breakdown-card flux-card">
            <span class="bd-label">{item.label}</span>
            <strong class="bd-value">{item.value}</strong>
            <p class="bd-note">{item.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 2: Interactive Evidence Images -->
    <section id="evidence-showcase" class="review-section" data-reveal>
      <Divider label={`02 · 原始测速与解锁截图证据 (${evidenceImages.length} 张)`} />
      <h2 class="sec-h2">未涂抹测速图与流媒体/AI 解锁实证（点击可拖拽放大）</h2>
      <p class="sec-sub">
        本站展示图均由桌面原图无损转为轻量 WebP 预览；点击任意卡片即可打开完整分辨率原图，支持滚轮缩放 300% 与鼠标拖拽核对每一个地区的延迟、单线程均值、峰值速率及流媒体标注。
      </p>

      <div class={`evidence-showcase-grid ${evidenceImages.length === 1 ? 'single-evidence' : ''}`}>
        {evidenceImages.map((img, idx) => (
          <article class="evidence-item flux-card">
            <div class="ev-head">
              <div class="ev-title-row">
                <span class="ev-badge">{categoryLabelMap[img.category]}</span>
                <span class="ev-idx">证据 #{idx + 1}</span>
              </div>
              <h3 class="ev-title">{img.title}</h3>
              <div class="ev-meta">
                <span>测试日期: {img.testedAt}</span>
                <span>环境: {img.env}</span>
                <span>协议: {img.protocol}</span>
              </div>
            </div>

            <button
              type="button"
              class="ev-img-trigger"
              data-full-src={img.src}
              data-title={img.title}
              data-date={`${img.testedAt} · ${img.env}`}
              aria-label={`点击放大查看 ${img.title} 高清原图`}
            >
              <img
                src={img.webp}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading={idx === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="ev-thumb"
              />
              <span class="ev-zoom-pill">🔍 放大看清每行节点数据</span>
            </button>

            <div class="ev-caption-wrap">
              <p class="ev-caption">{img.caption}</p>
              {img.notes && (
                <p class="ev-notes">
                  <strong>原始记录核注：</strong>{img.notes}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SECTION 3: Packages & Payment Table -->
    <section id="packages-table" class="review-section" data-reveal>
      <Divider label="03 · 套餐价格与单月流量全览" />
      <h2 class="sec-h2">{airport.name} 在售套餐价格、周期配额与支付方式</h2>

      <div class="pkg-meta-strip">
        <div>
          <span class="pm-label">优惠活动：</span>
          <span class="pm-val">{airport.discountActivity || '常规官方定价，无额外限时代金券记录'}</span>
        </div>
        <div>
          <span class="pm-label">支持付款：</span>
          <span class="pm-val">{airport.paymentMethods.join(' / ')}</span>
        </div>
        <div>
          <span class="pm-label">不限时包：</span>
          <span class="pm-val">{airport.hasUnlimitedPlan ? '提供永久/不限时按量套餐' : '仅提供周期重置流量套餐'}</span>
        </div>
      </div>

      {airport.packages && airport.packages.length > 0 ? (
        <div class="table-scroll-wrap">
          <table class="packages-table">
            <thead>
              <tr>
                <th>套餐名称</th>
                <th>计费周期</th>
                <th>官方标价</th>
                <th>流量配额</th>
                <th>适用场景与说明</th>
              </tr>
            </thead>
            <tbody>
              {airport.packages.map((pkg) => (
                <tr>
                  <td class="pkg-name">{pkg.name}</td>
                  <td>{pkg.cycle}</td>
                  <td class="pkg-price">{pkg.price}</td>
                  <td class="pkg-traffic">{pkg.traffic}</td>
                  <td class="pkg-period">{pkg.period}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="sec-sub">
          当前仅录入基础起步档位：<strong>{airport.startingPrice}</strong>（包含 <strong>{airport.monthlyTraffic}</strong> 流量），具体在售周期套餐请点击上方官网查看实时面板。
        </p>
      )}
    </section>

    <!-- SECTION 4: Unlock Matrix & Client Guide -->
    <section id="unlock-client" class="review-section" data-reveal>
      <Divider label="04 · 流媒体/AI 解锁分析与客户端指引" />
      <h2 class="sec-h2">ChatGPT / Claude / 流媒体解锁能力与客户端配置建议</h2>

      <div class="unlock-layout">
        <div class="unlock-matrix-box flux-card">
          <h3>实测解锁支持概览</h3>
          <div class="unlock-pills">
            <span class={`u-pill ${airport.aiUnlock.chatgpt ? 'ok' : 'no'}`}>
              ChatGPT {airport.aiUnlock.chatgpt ? '✓ 节点支持' : '✕ 需谨慎'}
            </span>
            <span class={`u-pill ${airport.aiUnlock.claude ? 'ok' : 'no'}`}>
              Claude {airport.aiUnlock.claude ? '✓ 节点支持' : '✕ 需谨慎'}
            </span>
            <span class={`u-pill ${airport.aiUnlock.midjourney ? 'ok' : 'no'}`}>
              Midjourney {airport.aiUnlock.midjourney ? '✓ 支持' : '✕ 不明'}
            </span>
            <span class={`u-pill ${airport.streamingUnlock.netflix ? 'ok' : 'no'}`}>
              Netflix 4K {airport.streamingUnlock.netflix ? '✓ 解锁' : '✕ 受限'}
            </span>
            <span class={`u-pill ${airport.streamingUnlock.disney ? 'ok' : 'no'}`}>
              Disney+ {airport.streamingUnlock.disney ? '✓ 解锁' : '✕ 部分区失败'}
            </span>
            <span class={`u-pill ${airport.streamingUnlock.youtube ? 'ok' : 'no'}`}>
              YouTube {airport.streamingUnlock.youtube ? '✓ 支持' : '✕ 送中风险'}
            </span>
          </div>

          <div class="coverage-block">
            <p><strong>节点覆盖与客户端口径：</strong>{airport.nodeCoverage || airport.features.join(' · ')}</p>
            <p><strong>适配工具 / 客户端：</strong>{airport.clientMode || airport.clientSupport.join(' · ')}</p>
          </div>

          <p class="unlock-prose">{review.unlockAnalysis}</p>
        </div>

        <div class="client-guide-box flux-card">
          <h3>分步上手与避坑配置建议</h3>
          <ol class="guide-steps">
            {review.clientSetupGuide.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <div class="guide-footer-links">
            <a href="/guides/" class="text-link">浏览 Clash / Shadowrocket / Sing-box 图文教程 →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: Honest Pros, Risks & Not Recommended For -->
    <section id="pros-cons" class="review-section" data-reveal>
      <Divider label="05 · 优缺点与适合/不适合人群" />
      <h2 class="sec-h2">{airport.name} 客观评价：优势、实测短板与避坑说明</h2>

      <div class="pros-cons-grid">
        <div class="pc-card pros flux-card">
          <h3>✅ 核心优势</h3>
          <ul>
            {(airport.pros || airport.features).map((pro) => (
              <li>{pro}</li>
            ))}
          </ul>
        </div>

        <div class="pc-card risks flux-card">
          <h3>⚠️ 真实短板与风险提示</h3>
          <ul>
            {(airport.risks || ['节点表现受本地宽带、路由拥塞及流媒体风控影响，建议先月付低档测试。']).map((risk) => (
              <li>{risk}</li>
            ))}
          </ul>
        </div>

        <div class="pc-card avoid flux-card">
          <h3>🚫 不建议购买人群</h3>
          <p>{airport.notRecommendedFor || '对单区原生静态住宅 IP 有严格刚需、或无法接受晚高峰跨省绕路波动的用户建议谨慎。'}</p>
          {airport.peerDifference && (
            <div class="peer-diff">
              <strong>与同类竞品差异：</strong>{airport.peerDifference}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- SECTION 6: FAQ -->
    <section id="faq" class="review-section" data-reveal>
      <Divider label="06 · 常见问题解答 FAQ" />
      <h2 class="sec-h2">{airport.name} 高频购买与使用疑问解答</h2>

      <div class="faq-list">
        {review.faqs.map((faq) => (
          <details class="faq-item flux-card" open>
            <summary class="faq-q">{faq.q}</summary>
            <p class="faq-a">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- SECTION 7: Cross-links & Next Reads -->
    <section id="related-compare" class="review-section" data-reveal>
      <Divider label="07 · 同档竞品实测与专题推荐" />
      <h2 class="sec-h2">横向对照品牌评测与选型延伸阅读</h2>

      <div class="related-layout">
        <div class="related-brands-col">
          <h3 class="sub-col-title">同场景对照品牌</h3>
          <div class="related-brands-grid">
            {relatedBrands.map((sib) => (
              <a
                href={sib.hasDeepReview ? `/airports/${sib.slug}/` : `/airports/#airport-${sib.id}`}
                class="related-brand-card flux-card"
              >
                <div class="rb-top">
                  <strong>{sib.name}</strong>
                  <span class="rb-price">{sib.startingPrice}</span>
                </div>
                <p class="rb-desc">{sib.lineType} · {sib.monthlyTraffic} · {sib.recommendedFor}</p>
                <span class="rb-cta">{sib.hasDeepReview ? '查看深度实测页 →' : '查看总榜档案 →'}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="related-articles-col">
          <h3 class="sub-col-title">相关选型专题与避坑教程</h3>
          <div class="related-articles-list">
            {review.relatedArticles.map((art) => (
              <a href={art.href} class="related-art-card flux-card">
                <span class="ra-tag">{art.tag}</span>
                <strong class="ra-title">{art.title}</strong>
                <span class="ra-arrow">→</span>
              </a>
            ))}
            <a href="/airports/" class="related-art-card flux-card">
              <span class="ra-tag">总榜矩阵</span>
              <strong class="ra-title">返回 2026 优质机场 42 品牌筛选总表与单 GB 计算器</strong>
              <span class="ra-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Full-Res Screenshot Pan & Zoom Lightbox Modal -->
  <div
    id="review-evidence-modal"
    class="evidence-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    data-pagefind-ignore
  >
    <div class="modal-backdrop" data-close-modal></div>
    <div class="modal-content">
      <div class="modal-head">
        <div class="mhead-title-wrap">
          <h3 id="rv-modal-title" class="mtitle">测速原图</h3>
          <span id="rv-modal-date" class="mdate"></span>
        </div>
        <div class="modal-toolbar">
          <button type="button" class="tool-btn" id="rv-zoom-out" title="缩小">➖ 缩小</button>
          <button type="button" class="tool-btn" id="rv-zoom-reset" title="适应窗口">⊡ 适应</button>
          <button type="button" class="tool-btn" id="rv-zoom-1to1" title="100%原始尺寸">1:1 原图</button>
          <button type="button" class="tool-btn" id="rv-zoom-in" title="放大">➕ 放大</button>
          <a id="rv-open-raw" href="#" target="_blank" rel="noopener noreferrer" class="tool-btn">新窗口打开 ↗</a>
          {hasExternalUrl && (
            <a
              href={airport.officialUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="tool-btn aff-btn"
            >
              前往官网 ↗
            </a>
          )}
          <button type="button" class="modal-close-btn" data-close-modal aria-label="关闭弹窗">×</button>
        </div>
      </div>

      <div class="modal-viewport" id="rv-modal-viewport">
        <div class="modal-img-container" id="rv-img-container">
          <img id="rv-modal-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="节点实测与解锁原图放大预览" draggable="false" />
        </div>
      </div>

      <div class="modal-footer-bar">
        <span class="zoom-tip">💡 提示：鼠标滚轮自由缩放（最高 300%），按住左键拖拽移动视野，按 ESC 退出</span>
        <span class="zoom-level-badge" id="rv-zoom-badge">适应窗口</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initReviewPageInteractions() {
    // 1. Copy Promo Code
    document.querySelectorAll('.promo-copy-btn').forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound === 'true') return;
      (btn as HTMLElement).dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-code') || '';
        const statusEl = btn.querySelector('.copy-status');
        if (navigator.clipboard && code) {
          navigator.clipboard.writeText(code).then(() => {
            if (statusEl) {
              statusEl.textContent = '✓ 已复制';
              setTimeout(() => {
                statusEl.textContent = '点击复制';
              }, 2200);
            }
          });
        }
      });
    });

    // 2. Evidence Modal Viewer
    const modal = document.getElementById('review-evidence-modal');
    if (!modal || modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    const modalTitle = document.getElementById('rv-modal-title');
    const modalDate = document.getElementById('rv-modal-date');
    const modalImg = document.getElementById('rv-modal-img') as HTMLImageElement | null;
    const openRaw = document.getElementById('rv-open-raw') as HTMLAnchorElement | null;
    const viewport = document.getElementById('rv-modal-viewport');
    const zoomBadge = document.getElementById('rv-zoom-badge');
    const zoomInBtn = document.getElementById('rv-zoom-in');
    const zoomOutBtn = document.getElementById('rv-zoom-out');
    const zoomResetBtn = document.getElementById('rv-zoom-reset');
    const zoom1to1Btn = document.getElementById('rv-zoom-1to1');

    let currentScale = 1;
    let isFitMode = true;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let scrollLeft = 0;
    let scrollTop = 0;

    function updateZoomDisplay() {
      if (!modalImg || !zoomBadge) return;
      if (isFitMode) {
        modalImg.style.width = 'auto';
        modalImg.style.maxWidth = '100%';
        modalImg.style.maxHeight = 'calc(92vh - 105px)';
        zoomBadge.textContent = '适应窗口';
      } else {
        modalImg.style.maxWidth = 'none';
        modalImg.style.maxHeight = 'none';
        const natWidth = modalImg.naturalWidth || 960;
        modalImg.style.width = `${Math.round(natWidth * currentScale)}px`;
        zoomBadge.textContent = `${Math.round(currentScale * 100)}%`;
      }
    }

    function openModal(src: string, title: string, date: string) {
      if (!modal || !modalImg || !modalTitle || !modalDate) return;
      modalTitle.textContent = title;
      modalDate.textContent = date;
      if (openRaw) openRaw.href = src;
      modalImg.src = src;
      modalImg.alt = `${title} 原图预览`;
      isFitMode = true;
      currentScale = 1;
      updateZoomDisplay();
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (viewport) {
        viewport.scrollTop = 0;
        viewport.scrollLeft = 0;
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.ev-img-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-full-src') || '';
        const title = btn.getAttribute('data-title') || '测速原图';
        const date = btn.getAttribute('data-date') || '';
        if (src) openModal(src, title, date);
      });
    });

    modal.querySelectorAll('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    zoomResetBtn?.addEventListener('click', () => {
      isFitMode = true;
      currentScale = 1;
      updateZoomDisplay();
    });

    zoom1to1Btn?.addEventListener('click', () => {
      isFitMode = false;
      currentScale = 1;
      updateZoomDisplay();
    });

    zoomInBtn?.addEventListener('click', () => {
      if (isFitMode) {
        isFitMode = false;
        currentScale = 1.25;
      } else {
        currentScale = Math.min(3, +(currentScale + 0.25).toFixed(2));
      }
      updateZoomDisplay();
    });

    zoomOutBtn?.addEventListener('click', () => {
      if (isFitMode) return;
      currentScale = Math.max(0.5, +(currentScale - 0.25).toFixed(2));
      if (currentScale <= 0.75) {
        isFitMode = true;
        currentScale = 1;
      }
      updateZoomDisplay();
    });

    viewport?.addEventListener(
      'wheel',
      (e) => {
        if (!modal.classList.contains('is-open')) return;
        e.preventDefault();
        if (e.deltaY < 0) {
          if (isFitMode) {
            isFitMode = false;
            currentScale = 1.15;
          } else {
            currentScale = Math.min(3, +(currentScale + 0.15).toFixed(2));
          }
        } else {
          if (isFitMode) return;
          currentScale = Math.max(0.5, +(currentScale - 0.15).toFixed(2));
          if (currentScale <= 0.8) {
            isFitMode = true;
            currentScale = 1;
          }
        }
        updateZoomDisplay();
      },
      { passive: false }
    );

    viewport?.addEventListener('mousedown', (e) => {
      if (!modal.classList.contains('is-open') || e.button !== 0) return;
      isDragging = true;
      startX = e.pageX - viewport.offsetLeft;
      startY = e.pageY - viewport.offsetTop;
      scrollLeft = viewport.scrollLeft;
      scrollTop = viewport.scrollTop;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    viewport?.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - viewport.offsetLeft;
      const y = e.pageY - viewport.offsetTop;
      viewport.scrollLeft = scrollLeft - (x - startX) * 1.3;
      viewport.scrollTop = scrollTop - (y - startY) * 1.3;
    });
  }

  document.addEventListener('astro:page-load', initReviewPageInteractions);
  initReviewPageInteractions();
</script>

