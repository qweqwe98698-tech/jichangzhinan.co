---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AirportFilterTerminal from '../../components/airports/AirportFilterTerminal.astro';
import AirportCompareTool from '../../components/airports/AirportCompareTool.astro';
import AirportEvidenceGallery from '../../components/airports/AirportEvidenceGallery.astro';
import AirportCostCalculator from '../../components/airports/AirportCostCalculator.astro';
import RealIPLCVerifier from '../../components/airports/RealIPLCVerifier.astro';
import Badge from '../../components/ui/Badge.astro';
import Divider from '../../components/ui/Divider.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { airportsData, deepReviewAirports, totalAirportsCount } from '../../data/airports';
import { siteConfig } from '../../config/site';

const measuredCount = deepReviewAirports.length;

const breadcrumbs = [
  { name: '首页', item: '/' },
  { name: `2026 优质机场推荐与评测总榜 (${totalAirportsCount}家)`, item: '/airports/' }
];

const airportsListSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `2026 优质机场推荐榜单与 ${totalAirportsCount} 品牌实测导航`,
    description: `汇集光速云、暮光加速、飞猫云、微风网络、大佬云、星岛梦、无忧链接等 ${totalAirportsCount} 家机场全档案：其中 ${measuredCount} 家配有真实测速/解锁图与独立深度评测页。`,
    url: `${siteConfig.url}/airports/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: airportsData.map((airport, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: `${airport.name}（${airport.lineType} · ${airport.startingPrice} / ${airport.monthlyTraffic}）`,
        url: airport.hasDeepReview
          ? `${siteConfig.url}/airports/${airport.slug}/`
          : `${siteConfig.url}/airports/#airport-${airport.id}`
      }))
    }
  }
];
---

<BaseLayout
  title={`2026 优质机场推荐榜单：${totalAirportsCount} 家高性价比与便宜专线全档案（${measuredCount} 家实测截图） | ${siteConfig.name}`}
  description={`2026 好用的翻墙机场与机场梯子怎么选？完整收录光速云、暮光加速、飞猫云、微风网络、大佬云、星岛梦、无忧链接等 ${totalAirportsCount} 家品牌：公开 ${measuredCount} 品牌 24 张真实测速/解锁图、18 篇独立深度评测、折扣码、单 GB 成本计算器与真假专线核验。`}
  breadcrumbs={breadcrumbs}
  extraSchemas={airportsListSchema}
>
  <div class="container airports-hub-page">
    <Breadcrumb items={breadcrumbs} />

    <!-- Top Hero Banner -->
    <header class="airports-hero-header" data-reveal>
      <div class="hero-pre-badge">
        <Badge variant="accent">
          <span class="signal-dot breathing"></span>
          2026 机场总榜 · {totalAirportsCount} 品牌档案库（{measuredCount} 家实测截图）
        </Badge>
        <span class="hero-update-tag">最近核验更新: 2026-11</span>
      </div>

      <h1 class="airports-main-title">2026 优质机场推荐榜单与 {totalAirportsCount} 家专线实测导航</h1>
      <p class="airports-lead-desc">
        <strong>快速结论</strong>：全站完整收纳 <strong>{totalAirportsCount} 家主流及历史机场品牌</strong>，前 10 位按主推序置顶（光速云、暮光加速、飞猫云、微风网络、大佬云、星岛梦、二猫云、无忧链接、唯兔云、Firefly）；日常主力优选 15–25 元/月高性价比 IEPL 专线，低预算入门可选飞猫云（¥7.5/月起）、无忧链接（年付折 7.4 元/月）或星岛梦（年付 8 折）。本站为 <strong>{measuredCount} 家配有实测截图的品牌建立了独立深度评测页</strong>，诚实标注 <code>0B</code>/失效节点、<code>送中(CN)</code> 及是否支持 Clash 订阅。<span style="color:var(--muted);">（商业披露：部分官网直达链接含合作返利参数，标注为 nofollow sponsored，评测结论保持独立客观。）</span>
      </p>

      <!-- Top Measured Deep-Review Quick Jump Strip -->
      <div class="deep-review-shortcuts" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.15rem;">
        <span style="font-family:var(--font-mono);font-size:0.74rem;color:var(--accent);align-self:center;">精选深度实测:</span>
        {deepReviewAirports.slice(0, 8).map((b) => (
          <a href={`/airports/${b.slug}/`} class="quick-nav-pill" style="border-color:rgba(124,255,178,0.35);">
            #{String(b.rankOrder).padStart(2, '0')} {b.name} 评测
          </a>
        ))}
      </div>

      <!-- Quick Anchor Navigation -->
      <div class="airports-quick-nav">
        <a href="#airport-filter" class="quick-nav-pill">● {totalAirportsCount} 品牌筛选矩阵</a>
        <a href="#evidence-gallery" class="quick-nav-pill">● 24 张实测与解锁图库</a>
        <a href="#airport-compare" class="quick-nav-pill">● 42 家横向 PK 对比</a>
        <a href="#cost-calculator" class="quick-nav-pill">● 单 GB 成本计算器</a>
        <a href="#iplc-verifier" class="quick-nav-pill">● 真假专线自检</a>
        <a href="#methodology" class="quick-nav-pill">● 评测准则与深度专刊</a>
      </div>
    </header>

    <!-- SECTION 1: Airport Filter Terminal (42 Brands) -->
    <section id="airport-filter" data-reveal>
      <AirportFilterTerminal />
    </section>

    <!-- SECTION 2: 18 Brands / 24 Measured Evidence Gallery -->
    <section id="evidence-gallery" data-reveal>
      <Divider label={`测速与解锁实证图库 · ${measuredCount} 品牌 24 张原图`} />
      <h2 class="airports-sub-heading" style="font-size:1.35rem;font-weight:700;margin:0 0 1rem;color:var(--text);">{measuredCount} 家实测机场测速截图与流媒体/AI 解锁证据库</h2>
      <AirportEvidenceGallery />
    </section>

    <!-- SECTION 3: Side-by-Side Brand Comparison -->
    <section id="airport-compare" data-reveal>
      <Divider label="品牌参数横向对比 · SIDE-BY-SIDE" />
      <h2 class="airports-sub-heading" style="font-size:1.35rem;font-weight:700;margin:0 0 1rem;color:var(--text);">机场品牌参数与套餐规格 PK 对比台</h2>
      <AirportCompareTool />
    </section>

    <!-- SECTION 4: Cost & Bandwidth Calculator -->
    <section id="cost-calculator" data-reveal>
      <Divider label="套餐预算估算 · COST CALCULATOR" />
      <h2 class="airports-sub-heading" style="font-size:1.35rem;font-weight:700;margin:0 0 1rem;color:var(--text);">月/季/年付单 GB 流量成本计算器</h2>
      <AirportCostCalculator />
    </section>

    <!-- SECTION 5: Real IPLC Verifier -->
    <section id="iplc-verifier" data-reveal>
      <Divider label="真伪 IPLC 鉴伪 · TOPOLOGY DIAGNOSTIC" />
      <h2 class="airports-sub-heading" style="font-size:1.35rem;font-weight:700;margin:0 0 1rem;color:var(--text);">真/伪 IPLC 与 IEPL 专线路由特征自检台</h2>
      <RealIPLCVerifier />
    </section>

    <!-- SECTION 6: Editorial Standards & Selection Methodology -->
    <section id="methodology" class="methodology-card flux-card" data-reveal>
      <div class="method-header">
        <span class="signal-dot"></span>
        <h2 class="method-title">机场指南编辑部 · 评测与选型六大准则</h2>
      </div>

      <div class="method-points-grid">
        <a href="#evidence-gallery" class="mpoint-item">
          <div class="mpoint-top">
            <span class="mpoint-idx">01</span>
            <span class="mpoint-badge">实测图库</span>
          </div>
          <h3>真实晚高峰压测与测速截图公开</h3>
          <p>18 家实测品牌共公开 24 张原始并发测速、三网对照与流媒体/AI 解锁截图，如实记录 0B 节点与送中局限。</p>
          <div class="mpoint-action">
            <span>查看 24 张实测与解锁证据画廊</span>
            <span class="action-arrow">↓</span>
          </div>
        </a>

        <a href="/articles/iplc-iepl-dedicated-line-airports/" class="mpoint-item">
          <div class="mpoint-top">
            <span class="mpoint-idx">02</span>
            <span class="mpoint-badge">专线深度</span>
          </div>
          <h3>拒绝假专线中继</h3>
          <p>严格审查服务商上游物理链路，排查是否使用廉价公网隧道冒充高成本的物理 IPLC/IEPL 内网专线。</p>
          <div class="mpoint-action">
            <span>阅读真假专线深度辨析</span>
            <span class="action-arrow">→</span>
          </div>
        </a>

        <a href="/articles/airport-scam-avoidance-and-fake-iplc/" class="mpoint-item">
          <div class="mpoint-top">
            <span class="mpoint-idx">03</span>
            <span class="mpoint-badge">避坑指南</span>
          </div>
          <h3>倍率透明无套路</h3>
          <p>严厉曝光标榜超大流量但节点倍率高达 5x-10x 的“倍率刺客”，优先收录 1.0x 真实倍率的良心服务商。</p>
          <div class="mpoint-action">
            <span>阅读倍率防坑与套路揭秘</span>
            <span class="action-arrow">→</span>
          </div>
        </a>

        <a href="/articles/best-airports-for-chatgpt-claude/" class="mpoint-item">
          <div class="mpoint-top">
            <span class="mpoint-idx">04</span>
            <span class="mpoint-badge">AI 解锁</span>
          </div>
          <h3>AI 与流媒体原生解锁</h3>
          <p>全节点深度测试 OpenAI (ChatGPT)、Claude 3.5、Midjourney 及 Netflix 4K、Disney+ 跨区原生解锁能力。</p>
          <div class="mpoint-action">
            <span>查看 ChatGPT/Claude 纯净专线</span>
            <span class="action-arrow">→</span>
          </div>
        </a>

        <a href="/guides/" class="mpoint-item">
          <div class="mpoint-top">
            <span class="mpoint-idx">05</span>
            <span class="mpoint-badge">客户端</span>
          </div>
          <h3>全协议与客户端生态</h3>
          <p>支持 Shadowsocks 2022、Vless-Reality、Hysteria 2、Trojan 等现代协议，并完美适配 Clash、Sing-box、Loon、Surge。</p>
          <div class="mpoint-action">
            <span>浏览客户端配置教程中心</span>
            <span class="action-arrow">→</span>
          </div>
        </a>

        <a href="/articles/cheap-budget-airports-recommendation/" class="mpoint-item">
          <div class="mpoint-top">
            <span class="mpoint-idx">06</span>
            <span class="mpoint-badge">平价精选</span>
          </div>
          <h3>多梯队灵活订阅</h3>
          <p>涵盖学生党平价月付、轻度用户按量不限时、极客高速 Hysteria2 及企业级独享住宅 IP 专线全矩阵。</p>
          <div class="mpoint-action">
            <span>查看平价与按量不限时推荐</span>
            <span class="action-arrow">→</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .airports-hub-page {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .airports-hero-header {
    max-width: 920px;
    margin-bottom: 3.5rem;
  }

  .hero-pre-badge {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-update-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .airports-main-title {
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .airports-lead-desc {
    font-size: 1.15rem;
    color: var(--text-soft);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .airports-quick-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .quick-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .quick-nav-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(124, 255, 178, 0.06);
    transform: translateY(-1px);
  }

  /* Methodology Card */
  .methodology-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-top: 3.5rem;
  }

  .method-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .method-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .method-points-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .mpoint-item {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .mpoint-item:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .mpoint-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mpoint-idx {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent);
  }

  .mpoint-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-soft);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    transition: all 0.2s ease;
  }

  .mpoint-item:hover .mpoint-badge {
    color: var(--accent);
    border-color: rgba(124, 255, 178, 0.3);
    background: rgba(124, 255, 178, 0.08);
  }

  .mpoint-item h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    transition: color 0.2s ease;
  }

  .mpoint-item:hover h3 {
    color: var(--accent);
  }

  .mpoint-item p {
    font-size: 0.88rem;
    color: var(--text-soft);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .mpoint-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.2s ease;
  }

  .action-arrow {
    transition: transform 0.2s ease;
  }

  .mpoint-item:hover .action-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .method-points-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .method-points-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
