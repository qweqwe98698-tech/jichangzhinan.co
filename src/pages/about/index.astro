---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Divider from '../../components/ui/Divider.astro';
import { siteConfig } from '../../config/site';

const breadcrumbs = [
  { name: '首页', item: '/' },
  { name: '关于网站', item: '/about/' }
];
---

<BaseLayout
  title={`关于网站与编辑原则 | ${siteConfig.name}`}
  description="了解机场指南的创办初衷、编辑准则、技术价值观与免责声明。"
  breadcrumbs={breadcrumbs}
>
  <div class="container about-page">
    <!-- Header -->
    <header class="about-header" data-reveal>
      <Badge variant="accent">
        <span class="signal-dot"></span>
        ABOUT FLUXGRID
      </Badge>
      <h1 class="about-title">关于 {siteConfig.name}</h1>
      <p class="about-desc">
        {siteConfig.description}
      </p>
    </header>

    <!-- Mission & Positioning -->
    <section class="about-sec flux-card" data-reveal>
      <div class="sec-head">
        <span class="signal-dot breathing"></span>
        <h2>网站定位与核心愿景</h2>
      </div>
      <p>
        在当今充斥着碎片化信息、机翻营销号与劣质广告的中文互联网环境中，寻找一份<strong>客观、经过工程级实测、代码规范严谨</strong>的网络技术指南变得异常困难。
      </p>
      <p>
        <strong>{siteConfig.name}</strong> 诞生于对优质网络知识与极简工程美学的执着追求。我们致力于打造一个融合了<strong>高级科技编辑部杂志质感</strong>与<strong>数据终端严谨性</strong>的数字知识中枢。
      </p>
    </section>

    <!-- Editorial Principles -->
    <section class="about-sec flux-card" id="editorial" data-reveal>
      <div class="sec-head">
        <span class="signal-dot blue"></span>
        <h2>编辑原则与内容标准</h2>
      </div>
      <div class="principles-grid">
        <div class="principle-item">
          <span class="principle-idx">01</span>
          <h3>真实验证原则</h3>
          <p>每一篇教程、配置代码与命令参数均经过团队在真实硬件与网络环境中的完整跑通与验证，拒绝云测评。</p>
        </div>
        <div class="principle-item">
          <span class="principle-idx">02</span>
          <h3>拒绝虚假指标</h3>
          <p>严禁捏造虚假浏览量、虚假评分或误导性性能图表。实测数据如实展现，不夸大也不隐瞒任何瓶颈。</p>
        </div>
        <div class="principle-item">
          <span class="principle-idx">03</span>
          <h3>开源与安全优先</h3>
          <p>优先推荐代码公开、经过社区安全审计的开源软件内核与客户端，并主动披露潜在的安全与隐私风险。</p>
        </div>
        <div class="principle-item">
          <span class="principle-idx">04</span>
          <h3>持续维护机制</h3>
          <p>网络协议演进迅速。我们为所有核心文章维护「最后更新时间」，定期针对软件大版本升级进行回溯修订。</p>
        </div>
      </div>
    </section>

    <!-- Technical Stack & Transparency -->
    <section class="about-sec flux-card" data-reveal>
      <div class="sec-head">
        <span class="signal-dot purple"></span>
        <h2>技术架构与隐私声明</h2>
      </div>
      <p>
        本站采用完全去中心化的静态 SSG (Static Site Generation) 技术构建，依托 Astro、Pagefind 与现代 CSS 变量体系。
      </p>
      <ul class="tech-points">
        <li><strong>零数据库追踪</strong>：全站无任何第三方用户追踪器或隐私收集行为。</li>
        <li><strong>极致静态交付</strong>：页面经全球 CDN 毫秒级分发，具备接近完美的 Lighthouse 性能表现。</li>
        <li><strong>无障碍设计</strong>：严格遵循语义化 HTML 与无障碍设计标准。</li>
      </ul>
    </section>

    <!-- Disclaimer & Contact -->
    <section class="about-sec flux-card" id="disclaimer" data-reveal>
      <div class="sec-head">
        <span class="signal-dot"></span>
        <h2>免责声明与联系方式</h2>
      </div>
      <div class="disclaimer-text" id="contact">
        <p>
          本站所刊载之所有技术教程、协议对比与配置示例仅供计算机网络学术研究、通信协议开发测试及合法网络运维参考。用户应遵守所在国家或地区的法律法规，因使用不当所产生之一切后果由使用者自行承担。
        </p>
        <p>
          如发现文章中存在技术纰漏或有合作交流建议，欢迎通过 Telegram 官方频道或 GitHub 开源社区与编辑部取得联系。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about-header {
    margin-bottom: 1rem;
  }

  .about-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .about-desc {
    font-size: 1.15rem;
    color: var(--text-soft);
    line-height: 1.75;
  }

  .about-sec {
    padding: 2.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .sec-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .sec-head h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .about-sec p {
    font-size: 1rem;
    color: var(--text-soft);
    line-height: 1.8;
  }

  .about-sec strong {
    color: #ffffff;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .principle-item {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .principle-idx {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-blue);
  }

  .principle-item h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .principle-item p {
    font-size: 0.88rem;
    margin: 0;
  }

  .tech-points {
    color: var(--text-soft);
    padding-left: 1.5rem;
    line-height: 1.8;
    margin-top: 1rem;
  }

  .disclaimer-text p {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
