---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/article/ReadingProgress.astro';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import ArticleTOC from '../components/article/ArticleTOC.astro';
import ArticleMeta from '../components/article/ArticleMeta.astro';
import RelatedPosts from '../components/article/RelatedPosts.astro';
import ArticleNavigation from '../components/article/ArticleNavigation.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { getClusterByTopic } from '../data/topicClusters';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      category: string;
      categoryName?: string;
      tags: string[];
      cover?: string;
      author: string;
      difficulty: string;
      readingTime: string;
      related?: string[];
      keyProblems?: string[];
      faq?: { q: string; a: string }[];
    };
  };
  headings: HeadingItem[];
  prevPost?: { id: string; title: string };
  nextPost?: { id: string; title: string };
}

const { post, headings, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, updatedDate, category, categoryName, tags, cover, author, difficulty, readingTime, related, keyProblems, faq } = post.data;
const clusterMeta = getClusterByTopic(category);

const breadcrumbs = [
  { name: '首页', item: '/' },
  { name: '知识专题', item: '/topics/' },
  { name: categoryName || category, item: `/topics/${category}/` },
  { name: title, item: `/articles/${post.id}/` }
];
---

<BaseLayout
  title={title}
  description={description}
  image={cover || '/og-cover.png'}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  category={category}
  breadcrumbs={breadcrumbs}
  faqs={faq}
  canonicalUrl={`https://jichangzhinan.co/articles/${post.id}/`}
>
  <!-- Reading Progress Bar -->
  <ReadingProgress />

  <article class="article-page-container container" data-pagefind-body>
    <div data-pagefind-ignore>
      <Breadcrumb items={breadcrumbs} />
    </div>

    <!-- Top Article Header -->
    <ArticleHeader
      title={title}
      description={description}
      category={category}
      categoryName={categoryName}
      pubDate={pubDate}
      updatedDate={updatedDate}
      author={author}
      difficulty={difficulty}
      readingTime={readingTime}
      keyProblems={keyProblems}
    />

    <!-- 3-Column Desktop Grid Layout -->
    <div class="article-body-grid">
      <!-- Left Column: Sticky Table of Contents -->
      <aside class="col-toc" aria-label="目录导航" data-pagefind-ignore>
        <ArticleTOC headings={headings} />
      </aside>

      <!-- Center Column: Core Article Content -->
      <div class="col-content">
        <!-- Main Markdown Prose Container -->
        <div class="prose-content" id="article-prose">
          <slot />
        </div>

        <!-- Inline FAQ Section if available -->
        {faq && faq.length > 0 && (
          <section class="article-faq-section" id="faq">
            <div class="faq-sec-header">
              <span class="signal-dot breathing"></span>
              <h2 class="faq-sec-title">FAQ / 常见问题解答</h2>
            </div>
            <div class="faq-items-list">
              {faq.map((item, idx) => (
                <div class="faq-card">
                  <div class="faq-q-row">
                    <span class="faq-idx">Q{idx + 1}.</span>
                    <h3 class="faq-question">{item.q}</h3>
                  </div>
                  <p class="faq-answer">{item.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Pillar-Cluster Hub Navigation & Commercial Entry -->
        {clusterMeta && (
          <section class="flux-card" style="margin:2rem 0 1.5rem;padding:1.25rem 1.5rem;border-color:var(--border-accent);" data-pagefind-ignore>
            <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
              <div style="font-size:0.875rem;font-weight:700;color:var(--text);">
                所属专题集群：<a href={`/topics/${clusterMeta.slug}/`} style="color:var(--accent);text-decoration:underline;text-underline-offset:3px;">{clusterMeta.name} →</a>
              </div>
              <a href="/airports/" style="font-size:0.8125rem;padding:0.25rem 0.7rem;border-radius:9999px;border:1px solid var(--border-accent);background:var(--accent-soft);color:var(--accent);text-decoration:none;">
                2026 优质机场总榜 (42家收录 · 18家实测)
              </a>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
              {clusterMeta.learningLinks.filter(l => l.href !== `/articles/${post.id}/`).slice(0, 4).map(link => (
                <a href={link.href} style="font-size:0.8125rem;padding:0.3rem 0.7rem;border-radius:6px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-soft);text-decoration:none;">
                  {link.tag}: {link.title.slice(0, 22)}{link.title.length > 22 ? '…' : ''}
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Prev / Next Navigation -->
        <div data-pagefind-ignore>
          <ArticleNavigation prevPost={prevPost} nextPost={nextPost} />

          <!-- Related Posts Network -->
          <RelatedPosts
            currentSlug={post.id}
            category={category}
            relatedSlugs={related}
          />
        </div>
      </div>

      <!-- Right Column: Sticky Article Meta -->
      <aside class="col-meta" aria-label="文章信息" data-pagefind-ignore>
        <ArticleMeta
          category={category}
          categoryName={categoryName}
          tags={tags}
          difficulty={difficulty}
          readingTime={readingTime}
          slug={post.id}
        />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    min-width: 0;
    max-width: 100%;
  }

  .article-body-grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 260px;
    gap: 3rem;
    align-items: start;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .col-toc {
    width: 100%;
  }

  .col-content {
    width: 100%;
    min-width: 0;
    max-width: min(var(--content-max-width), 100%);
    margin: 0 auto;
  }

  .col-meta {
    width: 100%;
  }

  /* Prose Content Styling */
  .prose-content {
    font-size: 1.06rem;
    line-height: 1.85;
    color: var(--text-soft);
    width: 100%;
    min-width: 0;
    max-width: 100%;
    contain: inline-size;
    overflow-wrap: break-word;
  }

  .prose-content :global(a),
  .prose-content :global(code) {
    overflow-wrap: anywhere;
  }

  .prose-content :global(pre),
  .prose-content :global(pre code) {
    overflow-wrap: normal;
    max-width: 100%;
    overflow-x: auto;
  }

  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .prose-content :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    letter-spacing: -0.025em;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .prose-content :global(h3) {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .prose-content :global(h4) {
    font-size: 1.1rem;
    color: var(--text);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .prose-content :global(p) {
    margin-bottom: 1.4rem;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.6rem;
  }

  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-content :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-content :global(a:hover) {
    color: #95ffc2;
  }

  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin: 2rem 0;
  }

  /* FAQ Accordion in Article */
  .article-faq-section {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .faq-sec-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .faq-sec-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .faq-items-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.5rem;
  }

  .faq-q-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .faq-idx {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-purple);
  }

  .faq-question {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
  }

  .faq-answer {
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 1200px) {
    .article-body-grid {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 2rem;
    }
    .col-meta {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .article-body-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .col-toc {
      display: none;
    }
  }
</style>
