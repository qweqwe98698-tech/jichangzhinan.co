---
import SearchTrigger from '../search/SearchTrigger.astro';
import LiveStats from './LiveStats.astro';
import TopicTicker from './TopicTicker.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  articleCount: number;
  topicCount: number;
  toolsCount: number;
}

const { articleCount, topicCount, toolsCount } = Astro.props;
---

<section class="flux-hero-section" aria-label="首屏介绍">
  <div class="container hero-container">
    <!-- Left Hero Column -->
    <div class="hero-content-col" data-reveal>
      <div class="hero-pre-badge">
        <Badge variant="accent">
          <span class="signal-dot breathing" aria-hidden="true"></span>
          2026 实测更新 · IPLC / IEPL 专线与代理教程库
        </Badge>
      </div>

      <h1 class="hero-headline">
        2026 优质机场推荐与专线评测导航
        <span class="headline-sub">收录 42 家高性价比机场、便宜入门方案与 18 家真实测速解锁实测证据</span>
      </h1>

      <p class="hero-description">
        聚焦 <strong>IPLC/IEPL 纯专线机场</strong>、<strong>15–20 元高性价比主力梯队</strong>、<strong>低预算便宜机场</strong>与 <strong>ChatGPT / Claude 原生纯净 IP</strong> 实测，搭配 Clash Verge Rev、Shadowrocket 全平台教程。含实测数据与合作返利链接，坚持独立筛选。
      </p>

      <div class="hero-quick-intents" style="display:flex;flex-wrap:wrap;gap:0.625rem;margin:1.25rem 0 0.5rem;">
        <a href="/airports/" style="font-size:0.8125rem;padding:0.35rem 0.85rem;border-radius:9999px;border:1px solid var(--border-accent);background:var(--accent-soft);color:var(--accent);text-decoration:none;">2026 机场总榜与筛选 →</a>
        <a href="/articles/high-value-cost-effective-airports/" style="font-size:0.8125rem;padding:0.35rem 0.85rem;border-radius:9999px;border:1px solid var(--border);background:var(--surface);color:var(--text-soft);text-decoration:none;">高性价比 IEPL (15-20元)</a>
        <a href="/articles/cheap-budget-airports-recommendation/" style="font-size:0.8125rem;padding:0.35rem 0.85rem;border-radius:9999px;border:1px solid var(--border);background:var(--surface);color:var(--text-soft);text-decoration:none;">便宜机场入口 (&le;15元)</a>
        <a href="/articles/best-airports-for-chatgpt-claude/" style="font-size:0.8125rem;padding:0.35rem 0.85rem;border-radius:9999px;border:1px solid var(--border);background:var(--surface);color:var(--text-soft);text-decoration:none;">纯净 IP / AI 专线</a>
        <a href="/articles/airport-ladder-beginner-selection-guide/" style="font-size:0.8125rem;padding:0.35rem 0.85rem;border-radius:9999px;border:1px solid var(--border);background:var(--surface);color:var(--text-soft);text-decoration:none;">新手梯子三步入门</a>
      </div>

      <!-- Large Hero Search Entry -->
      <div class="hero-search-wrapper">
        <SearchTrigger variant="hero" />
      </div>

      <!-- Hot Topic Tags -->
      <TopicTicker />
    </div>

    <!-- Right Live Stats Card -->
    <div class="hero-stats-col" data-reveal data-reveal-delay="2">
      <LiveStats
        articleCount={articleCount}
        topicCount={topicCount}
        toolsCount={toolsCount}
      />
    </div>
  </div>
</section>

<style>
  .flux-hero-section {
    position: relative;
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-content-col {
    display: flex;
    flex-direction: column;
  }

  .hero-pre-badge {
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .headline-sub {
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 600;
    color: var(--text-soft);
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: 1.08rem;
    color: var(--text-soft);
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .hero-search-wrapper {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .hero-stats-col {
    width: 100%;
    max-width: 440px;
    justify-self: end;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-stats-col {
      justify-self: start;
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .flux-hero-section {
      padding-top: 2rem;
      padding-bottom: 2.5rem;
    }
  }
</style>
