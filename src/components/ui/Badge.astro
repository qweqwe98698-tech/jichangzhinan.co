---
interface Props {
  variant?: 'default' | 'accent' | 'blue' | 'purple' | 'warning' | 'muted';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'sm',
  class: className = ''
} = Astro.props;
---

<span class={`flux-badge badge-${variant} badge-${size} ${className}`}>
  <slot />
</span>

<style>
  .flux-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-full);
    padding: 0.2rem 0.65rem;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-soft);
  }

  .badge-accent {
    border-color: rgba(124, 255, 178, 0.25);
    background: rgba(124, 255, 178, 0.08);
    color: var(--accent);
  }

  .badge-blue {
    border-color: rgba(114, 167, 255, 0.25);
    background: rgba(114, 167, 255, 0.08);
    color: var(--accent-blue);
  }

  .badge-purple {
    border-color: rgba(169, 140, 255, 0.25);
    background: rgba(169, 140, 255, 0.08);
    color: var(--accent-purple);
  }

  .badge-warning {
    border-color: rgba(243, 202, 115, 0.25);
    background: rgba(243, 202, 115, 0.08);
    color: var(--warning);
  }

  .badge-muted {
    border-color: var(--border);
    background: transparent;
    color: var(--muted);
  }

  .badge-sm {
    font-size: 0.68rem;
    padding: 0.18rem 0.5rem;
  }

  .badge-md {
    font-size: 0.78rem;
    padding: 0.28rem 0.75rem;
  }
</style>
