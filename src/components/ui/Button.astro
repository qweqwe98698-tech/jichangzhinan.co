---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  target?: string;
  rel?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
}

const {
  href,
  variant = 'secondary',
  size = 'md',
  target,
  rel,
  class: className = '',
  type = 'button',
  id
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={rel || (target === '_blank' ? 'noopener noreferrer' : undefined)}
  class={`flux-btn btn-${variant} btn-${size} magnetic-btn ${className}`}
  type={!href ? type : undefined}
  id={id}
>
  <slot />
</Tag>

<style>
  .flux-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--accent);
    color: #05080c;
    font-weight: 600;
    border-color: var(--accent);
    box-shadow: 0 0 16px rgba(124, 255, 178, 0.2);
  }

  .btn-primary:hover {
    background: #95ffc2;
    box-shadow: 0 0 22px rgba(124, 255, 178, 0.4);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--border);
  }

  .btn-secondary:hover {
    background: var(--surface-hover);
    border-color: var(--border-hover);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    color: var(--text);
    border-color: var(--border);
  }

  .btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(124, 255, 178, 0.04);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-soft);
    border-color: transparent;
  }

  .btn-ghost:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .btn-sm {
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
  }

  .btn-md {
    font-size: 0.95rem;
    padding: 0.55rem 1.15rem;
  }

  .btn-lg {
    font-size: 1.05rem;
    padding: 0.75rem 1.6rem;
  }
</style>
