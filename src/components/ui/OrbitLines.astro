---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`orbit-lines-container ${className}`} aria-hidden="true">
  <svg class="orbit-svg" viewBox="0 0 1000 600" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Primary Orbit Track -->
    <path
      class="orbit-track track-1"
      d="M -100 200 C 250 80, 750 480, 1100 300"
      stroke="url(#orbit-grad-1)"
      stroke-width="1.2"
      stroke-dasharray="6 8"
    />
    <!-- Secondary Orbit Track -->
    <path
      class="orbit-track track-2"
      d="M -50 450 C 350 550, 700 100, 1050 220"
      stroke="url(#orbit-grad-2)"
      stroke-width="1"
      stroke-dasharray="4 6"
    />
    <!-- Tertiary Orbit Arc -->
    <ellipse
      cx="750"
      cy="280"
      rx="240"
      ry="120"
      transform="rotate(-15 750 280)"
      class="orbit-track track-3"
      stroke="rgba(114, 167, 255, 0.12)"
      stroke-width="1"
      stroke-dasharray="3 5"
    />

    <!-- Moving Glow Nodes on Path -->
    <circle cx="0" cy="0" r="3.5" fill="#7CFFB2" class="moving-node node-1">
      <animateMotion
        path="M -100 200 C 250 80, 750 480, 1100 300"
        dur="18s"
        repeatCount="indefinite"
      />
    </circle>
    <circle cx="0" cy="0" r="2.5" fill="#72A7FF" class="moving-node node-2">
      <animateMotion
        path="M 1050 220 C 700 100, 350 550, -50 450"
        dur="24s"
        repeatCount="indefinite"
      />
    </circle>

    <!-- Linear Gradients for Tracks -->
    <defs>
      <linearGradient id="orbit-grad-1" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#7CFFB2" stop-opacity="0" />
        <stop offset="30%" stop-color="#7CFFB2" stop-opacity="0.18" />
        <stop offset="70%" stop-color="#72A7FF" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#A98CFF" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="orbit-grad-2" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#72A7FF" stop-opacity="0" />
        <stop offset="50%" stop-color="#A98CFF" stop-opacity="0.15" />
        <stop offset="100%" stop-color="#7CFFB2" stop-opacity="0" />
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  .orbit-lines-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .orbit-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .orbit-track {
    opacity: 0.85;
  }

  .moving-node {
    filter: drop-shadow(0 0 6px currentColor);
  }

  @media (prefers-reduced-motion: reduce) {
    .moving-node animateMotion {
      dur: 0s;
    }
  }
</style>
