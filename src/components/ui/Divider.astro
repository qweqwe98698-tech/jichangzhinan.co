---
interface Props {
  label?: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<div class={`flux-divider ${label ? 'with-label' : ''} ${className}`}>
  {label && (
    <div class="divider-inner">
      <span class="divider-node"></span>
      <span class="divider-label">{label}</span>
      <span class="divider-node"></span>
    </div>
  )}
</div>

<style>
  .flux-divider {
    position: relative;
    width: 100%;
    height: 1px;
    background: var(--border);
    margin: 3rem 0;
  }

  .flux-divider.with-label {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .flux-divider.with-label::before,
  .flux-divider.with-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .divider-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .divider-node {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }
</style>
