---
import { airportsData, totalAirportsCount } from '../../data/airports';

const comparePayload = airportsData.map((a) => ({
  id: a.id,
  rankOrder: a.rankOrder,
  name: a.name,
  slug: a.slug,
  lineType: a.lineType,
  startingPrice: a.startingPrice,
  monthlyTraffic: a.monthlyTraffic,
  protocols: a.protocols,
  openedYear: a.openedYear,
  discountCode: a.discountCode || '暂无额外券码',
  discountActivity: a.discountActivity || '常规官方价格',
  paymentMethods: a.paymentMethods,
  streamingUnlock: a.streamingUnlock,
  aiUnlock: a.aiUnlock,
  ratingScore: a.ratingScore,
  recommendedFor: a.recommendedFor,
  officialUrl: a.officialUrl,
  dataStatus: a.dataStatus,
  hasDeepReview: a.hasDeepReview,
  supportsThirdPartySub: a.supportsThirdPartySub !== false,
  hasUnlimitedPlan: Boolean(a.hasUnlimitedPlan),
  clientMode: a.clientMode || a.clientSupport.join(' / '),
  nodeCoverage: a.nodeCoverage || a.features.join(' / ')
}));

const defaultBrandA = comparePayload[0];
const defaultBrandB = comparePayload[2] || comparePayload[1];
---

<div class="compare-terminal flux-card" id="airport-compare-root">
  <div class="compare-head">
    <div>
      <h3 class="compare-title">{totalAirportsCount} 家机场品牌横向对决 PK 终端</h3>
      <p class="compare-sub">自由选取 42 品牌库中任意两家（支持实测品牌、厂商口径及历史品牌对照），一键对比套餐起步价、协议、订阅支持与解锁短板。</p>
    </div>
  </div>

  <div class="compare-selectors">
    <div class="sel-col">
      <label for="compare-brand-a" class="sel-lbl">对比品牌 A</label>
      <select id="compare-brand-a" class="brand-select">
        {airportsData.map((item) => (
          <option value={item.id} selected={item.id === defaultBrandA.id}>
            #{String(item.rankOrder).padStart(2, '0')} {item.name} · {item.startingPrice} ({item.dataStatus === 'measured' ? '实测' : item.dataStatus === 'vendor' ? '厂商' : '档案'})
          </option>
        ))}
      </select>
    </div>

    <div class="vs-badge" aria-hidden="true">VS</div>

    <div class="sel-col">
      <label for="compare-brand-b" class="sel-lbl">对比品牌 B</label>
      <select id="compare-brand-b" class="brand-select">
        {airportsData.map((item) => (
          <option value={item.id} selected={item.id === defaultBrandB.id}>
            #{String(item.rankOrder).padStart(2, '0')} {item.name} · {item.startingPrice} ({item.dataStatus === 'measured' ? '实测' : item.dataStatus === 'vendor' ? '厂商' : '档案'})
          </option>
        ))}
      </select>
    </div>
  </div>

  <div class="compare-table-scroll">
    <table class="compare-table">
      <thead>
        <tr>
          <th class="col-dim">对比维度</th>
          <th id="th-brand-a">{defaultBrandA.name}</th>
          <th id="th-brand-b">{defaultBrandB.name}</th>
        </tr>
      </thead>
      <tbody id="compare-tbody">
        <tr>
          <td class="col-dim">数据核验口径</td>
          <td id="cmp-status-a">—</td>
          <td id="cmp-status-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">底层线路与创立年份</td>
          <td id="cmp-line-a">—</td>
          <td id="cmp-line-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">起步价格与配额</td>
          <td id="cmp-price-a">—</td>
          <td id="cmp-price-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">不限时流量包</td>
          <td id="cmp-unlimited-a">—</td>
          <td id="cmp-unlimited-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">核心支持协议</td>
          <td id="cmp-proto-a">—</td>
          <td id="cmp-proto-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">第三方订阅支持</td>
          <td id="cmp-sub-a">—</td>
          <td id="cmp-sub-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">AI 与流媒体解锁</td>
          <td id="cmp-unlock-a">—</td>
          <td id="cmp-unlock-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">折扣码 / 优惠</td>
          <td id="cmp-promo-a">—</td>
          <td id="cmp-promo-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">综合适用场景</td>
          <td id="cmp-rec-a">—</td>
          <td id="cmp-rec-b">—</td>
        </tr>
        <tr>
          <td class="col-dim">操作与实测入口</td>
          <td id="cmp-cta-a">—</td>
          <td id="cmp-cta-b">—</td>
        </tr>
      </tbody>
    </table>
  </div>

  <script type="application/json" id="compare-airports-json" set:html={JSON.stringify(comparePayload)} />
</div>

<script>
  function setupAirportCompare() {
    const root = document.getElementById('airport-compare-root');
    if (!root || root.dataset.compareBound === 'true') return;
    root.dataset.compareBound = 'true';

    const dataScript = document.getElementById('compare-airports-json');
    if (!dataScript || !dataScript.textContent) return;

    let brands = [] as any[];
    try {
      brands = JSON.parse(dataScript.textContent);
    } catch {
      return;
    }

    const selA = document.getElementById('compare-brand-a') as HTMLSelectElement | null;
    const selB = document.getElementById('compare-brand-b') as HTMLSelectElement | null;
    if (!selA || !selB) return;

    const statusLabelMap: Record<string, string> = {
      measured: '✓ 有实测图证据（含独立深度评测页）',
      vendor: '◈ 厂商公开口径（未录测速图）',
      historic: 'Archive · 历史档案对照'
    };

    function setText(id: string, text: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function renderActionCell(cellId: string, brand: any) {
      const cell = document.getElementById(cellId);
      if (!cell) return;
      cell.innerHTML = '';

      const wrap = document.createElement('div');
      wrap.className = 'cmp-action-wrap';

      const isExternal = /^https?:\/\//i.test(brand.officialUrl);
      if (isExternal) {
        const affLink = document.createElement('a');
        affLink.href = brand.officialUrl;
        affLink.target = '_blank';
        affLink.rel = 'nofollow sponsored noopener noreferrer';
        affLink.className = 'cmp-btn primary';
        affLink.textContent = `前往 ${brand.name} 官网 ↗`;
        wrap.appendChild(affLink);
      } else {
        const archLink = document.createElement('a');
        archLink.href = `#airport-${brand.id}`;
        archLink.className = 'cmp-btn muted';
        archLink.textContent = '仅档案 · 无独立外链';
        wrap.appendChild(archLink);
      }

      if (brand.hasDeepReview) {
        const revLink = document.createElement('a');
        revLink.href = `/airports/${brand.slug}/`;
        revLink.className = 'cmp-btn outline';
        revLink.textContent = '实测深度评测 →';
        wrap.appendChild(revLink);
      }

      cell.appendChild(wrap);
    }

    function renderSide(side: 'a' | 'b', brand: any) {
      if (!brand) return;
      setText(`th-brand-${side}`, `#${String(brand.rankOrder).padStart(2, '0')} ${brand.name}`);
      setText(`cmp-status-${side}`, statusLabelMap[brand.dataStatus] || brand.dataStatus);
      setText(`cmp-line-${side}`, `${brand.lineType}（创于 ${brand.openedYear} 年 · ${brand.ratingScore.toFixed(1)}分）`);
      setText(`cmp-price-${side}`, `${brand.startingPrice} / ${brand.monthlyTraffic}`);
      setText(`cmp-unlimited-${side}`, brand.hasUnlimitedPlan ? '✓ 提供不限时/永久流量包' : '✕ 仅周期重置套餐');
      setText(`cmp-proto-${side}`, brand.protocols.join(' · '));
      setText(`cmp-sub-${side}`, brand.supportsThirdPartySub ? `支持通用订阅 (${brand.clientMode})` : `仅限自研客户端 (${brand.clientMode})`);
      setText(
        `cmp-unlock-${side}`,
        `ChatGPT ${brand.aiUnlock.chatgpt ? '✓' : '△'} / Claude ${brand.aiUnlock.claude ? '✓' : '△'} / NF ${brand.streamingUnlock.netflix ? '✓' : '△'}`
      );
      setText(`cmp-promo-${side}`, `${brand.discountCode} · ${brand.discountActivity}`);
      setText(`cmp-rec-${side}`, `${brand.recommendedFor}（覆盖: ${brand.nodeCoverage}）`);
      renderActionCell(`cmp-cta-${side}`, brand);
    }

    function syncComparison() {
      const brandA = brands.find((b) => b.id === selA!.value) || brands[0];
      const brandB = brands.find((b) => b.id === selB!.value) || brands[2] || brands[1];
      renderSide('a', brandA);
      renderSide('b', brandB);
    }

    selA.addEventListener('change', syncComparison);
    selB.addEventListener('change', syncComparison);
    syncComparison();
  }

  document.addEventListener('astro:page-load', setupAirportCompare);
  setupAirportCompare();
</script>

<style>
  .compare-terminal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-bottom: 3rem;
  }

  .compare-title {
    margin: 0 0 0.45rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
  }

  .compare-sub {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--text-soft);
    line-height: 1.65;
  }

  .compare-selectors {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .sel-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .sel-lbl {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent);
  }

  .brand-select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: 0.86rem;
  }

  .vs-badge {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--accent);
    background: rgba(124, 255, 178, 0.1);
    border: 1px solid rgba(124, 255, 178, 0.35);
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .compare-table-scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .compare-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .compare-table th,
  .compare-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    text-align: left;
    vertical-align: top;
    line-height: 1.6;
  }

  .compare-table th {
    background: rgba(9, 11, 16, 0.65);
    color: #ffffff;
    font-weight: 700;
  }

  .compare-table td.col-dim,
  .compare-table th.col-dim {
    width: 165px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    background: rgba(9, 11, 16, 0.35);
  }

  :global(.cmp-action-wrap) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.cmp-btn) {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.78rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
  }

  :global(.cmp-btn.primary) {
    background: var(--accent);
    color: #090b10;
  }

  :global(.cmp-btn.outline) {
    border: 1px solid var(--border);
    color: var(--accent);
  }

  :global(.cmp-btn.muted) {
    border: 1px solid var(--border);
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .compare-terminal {
      padding: 1.15rem;
    }

    .compare-selectors {
      grid-template-columns: 1fr;
    }

    .vs-badge {
      justify-self: start;
    }
  }
</style>
