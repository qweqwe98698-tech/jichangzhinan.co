---
import { deepReviewAirports, type AirportItem, type EvidenceImage } from '../../data/airports';

interface GalleryEntry {
  airport: AirportItem;
  img: EvidenceImage;
  idx: number;
}

const evidenceEntries: GalleryEntry[] = deepReviewAirports.flatMap((airport) => {
  const list: EvidenceImage[] =
    airport.evidenceImages && airport.evidenceImages.length > 0
      ? airport.evidenceImages
      : airport.speedtestImage
        ? [
            {
              src: airport.speedtestImage,
              webp: airport.speedtestImage
                .replace('/speedtest/', '/speedtest/webp/')
                .replace(/\.(png|jpe?g)$/i, '.webp'),
              width: 960,
              height: 1200,
              title: `${airport.name} 测速实测原图`,
              caption: `${airport.name} ${airport.lineType} 节点实测结果`,
              alt: `${airport.name} (${airport.lineType}) 节点测速实测图`,
              testedAt: airport.speedtestDate,
              category: 'speedtest',
              env: '实测网络环境',
              protocol: airport.protocols.join(' / ')
            }
          ]
        : [];

  return list.map((img, idx) => ({ airport, img, idx }));
});

const totalImages = evidenceEntries.length;
const totalBrands = deepReviewAirports.length;
const guangsuCount = evidenceEntries.filter((e) => e.airport.slug === 'guangsu-cloud').length;
const unlockCount = evidenceEntries.filter(
  (e) => e.img.category === 'unlock' || e.img.category === 'isp-matrix'
).length;
const speedCount = evidenceEntries.filter((e) => e.img.category === 'speedtest').length;

const catLabelMap: Record<EvidenceImage['category'], string> = {
  speedtest: '速度实测',
  unlock: 'AI / 流媒体解锁',
  'isp-matrix': '三网对照'
};
---

<div class="gallery-wrapper" id="evidence-gallery-root">
  <div class="gallery-head-meta">
    <div class="gallery-desc-wrap">
      <p class="gallery-sub">
        收录 <strong>{totalBrands} 个实测品牌共 {totalImages} 张原始测速与解锁截图</strong>（含光速云 6 张多省/9Gbps 图、无忧链接双图、微风 VLESS 原图及 15 家 08-11 统一标准测速）。点击卡片可打开大图缩放拖拽。
      </p>
    </div>

    <div class="gallery-filter-pills" id="gallery-filter-pills">
      <button type="button" class="g-pill is-active" data-gfilter="all">
        全部实测图 ({totalImages})
      </button>
      <button type="button" class="g-pill" data-gfilter="top10">
        Top 10 主推品牌
      </button>
      <button type="button" class="g-pill" data-gfilter="guangsu">
        光速云多维实证 ({guangsuCount})
      </button>
      <button type="button" class="g-pill" data-gfilter="unlock">
        流媒体/三网矩阵 ({unlockCount})
      </button>
      <button type="button" class="g-pill" data-gfilter="speedtest">
        节点纯测速图 ({speedCount})
      </button>
    </div>
  </div>

  <div class="evidence-grid">
    {evidenceEntries.map(({ airport, img, idx }) => (
      <article
        class="evidence-thumb-card flux-card"
        data-img={img.src}
        data-name={`${airport.name} · ${img.title}`}
        data-date={`${img.testedAt} · ${img.env}`}
        data-aff={airport.officialUrl}
        data-review-url={`/airports/${airport.slug}/`}
        data-category={img.category}
        data-top10={airport.isTopTen ? 'true' : 'false'}
        data-slug={airport.slug}
      >
        <div class="thumb-top">
          <div class="thumb-title-col">
            <span class="thumb-name">
              #{String(airport.rankOrder).padStart(2, '0')} {airport.name}
            </span>
            <span class="thumb-sub-title">{img.title}</span>
          </div>
          <span class="thumb-tag">{catLabelMap[img.category]}</span>
        </div>

        <div class="img-crop-box" role="button" tabindex="0" aria-label={`查看大图: ${img.title}`}>
          <img
            src={img.webp}
            alt={img.alt}
            width={img.width}
            height={img.height}
            loading="lazy"
            decoding="async"
            class="thumb-img"
            draggable="false"
          />
          <div class="img-overlay">
            <span class="view-btn">🔍 交互拖拽查看原图</span>
          </div>
        </div>

        <p class="thumb-caption">{img.caption}</p>

        <div class="thumb-foot">
          <span class="test-date-lbl">{img.testedAt} · 图#{idx + 1}</span>
          <div class="foot-links">
            <a href={`/airports/${airport.slug}/`} class="link-review">深度评测 →</a>
            <a
              href={airport.officialUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="link-aff"
            >
              官网 ↗
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Lightbox Modal -->
  <div id="evidence-modal" class="evidence-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-content">
      <div class="modal-head">
        <div class="mhead-title-wrap">
          <h3 id="modal-title" class="mtitle">实测测速原图</h3>
          <span id="modal-date" class="mdate"></span>
        </div>
        <div class="modal-toolbar">
          <button type="button" class="tool-btn" id="zoom-out-btn" title="缩小">➖ 缩小</button>
          <button type="button" class="tool-btn" id="zoom-reset-btn" title="适应屏幕大小">⊡ 适应窗口</button>
          <button type="button" class="tool-btn" id="zoom-1to1-btn" title="100% 原始尺寸">1:1 原图</button>
          <button type="button" class="tool-btn" id="zoom-in-btn" title="放大">➕ 放大</button>
          <a id="modal-review-link" href="/airports/" class="tool-btn">查看该品牌评测 →</a>
          <a id="modal-raw-link" href="#" target="_blank" rel="noopener noreferrer" class="tool-btn">新窗口 ↗</a>
          <a id="modal-aff-link" href="#" target="_blank" rel="nofollow sponsored noopener noreferrer" class="tool-btn aff-btn">
            官网 ↗
          </a>
          <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="关闭弹窗">×</button>
        </div>
      </div>

      <div class="modal-viewport" id="modal-viewport">
        <div class="modal-img-container" id="modal-img-container">
          <img id="modal-full-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="节点测速实测原图" draggable="false" />
        </div>
      </div>

      <div class="modal-footer-bar">
        <span class="zoom-tip">💡 提示：支持鼠标滚轮自由缩放（最高 300%），按住左键拖拽查看各个地区详情，按 ESC 退出</span>
        <span class="zoom-level-badge" id="zoom-level-badge">适应窗口</span>
      </div>
    </div>
  </div>
</div>

<script>
  function setupEvidenceGallery() {
    const root = document.getElementById('evidence-gallery-root');
    if (!root || root.dataset.galleryBound === 'true') return;
    root.dataset.galleryBound = 'true';

    // 1. Category Filter
    const filterWrap = document.getElementById('gallery-filter-pills');
    const cards = Array.from(root.querySelectorAll('.evidence-thumb-card')) as HTMLElement[];

    filterWrap?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.g-pill') as HTMLElement | null;
      if (!btn) return;
      const filter = btn.dataset.gfilter || 'all';
      filterWrap.querySelectorAll('.g-pill').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const isTop10 = card.dataset.top10 === 'true';
        const slug = card.dataset.slug || '';

        let show = true;
        if (filter === 'top10') show = isTop10;
        else if (filter === 'guangsu') show = slug === 'guangsu-cloud';
        else if (filter === 'unlock') show = cat === 'unlock' || cat === 'isp-matrix';
        else if (filter === 'speedtest') show = cat === 'speedtest';

        card.style.display = show ? '' : 'none';
      });
    });

    // 2. Modal Pan & Zoom
    const modal = document.getElementById('evidence-modal');
    if (!modal) return;

    const modalTitle = document.getElementById('modal-title');
    const modalDate = document.getElementById('modal-date');
    const modalImg = document.getElementById('modal-full-img') as HTMLImageElement | null;
    const modalAffLink = document.getElementById('modal-aff-link') as HTMLAnchorElement | null;
    const modalReviewLink = document.getElementById('modal-review-link') as HTMLAnchorElement | null;
    const modalRawLink = document.getElementById('modal-raw-link') as HTMLAnchorElement | null;
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const viewport = document.getElementById('modal-viewport');
    const zoomBadge = document.getElementById('zoom-level-badge');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomResetBtn = document.getElementById('zoom-reset-btn');
    const zoom1to1Btn = document.getElementById('zoom-1to1-btn');

    let currentScale = 1;
    let isFitMode = true;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let scrollLeft = 0;
    let scrollTop = 0;

    function updateZoomDisplay() {
      if (!modalImg || !zoomBadge) return;
      if (isFitMode) {
        modalImg.style.width = 'auto';
        modalImg.style.maxWidth = '100%';
        modalImg.style.maxHeight = 'calc(92vh - 108px)';
        zoomBadge.textContent = '适应窗口';
      } else {
        modalImg.style.maxWidth = 'none';
        modalImg.style.maxHeight = 'none';
        const natWidth = modalImg.naturalWidth || 960;
        modalImg.style.width = `${Math.round(natWidth * currentScale)}px`;
        zoomBadge.textContent = `${Math.round(currentScale * 100)}%`;
      }
    }

    function openCardModal(card: HTMLElement) {
      const imgPath = card.getAttribute('data-img') || '';
      const name = card.getAttribute('data-name') || '';
      const date = card.getAttribute('data-date') || '';
      const aff = card.getAttribute('data-aff') || '#';
      const reviewUrl = card.getAttribute('data-review-url') || '/airports/';

      if (!imgPath || !modalImg) return;
      if (modalTitle) modalTitle.textContent = name;
      if (modalDate) modalDate.textContent = date;
      if (modalAffLink) modalAffLink.href = aff;
      if (modalReviewLink) modalReviewLink.href = reviewUrl;
      if (modalRawLink) modalRawLink.href = imgPath;

      modalImg.src = imgPath;
      modalImg.alt = `${name} 实测原图`;
      isFitMode = true;
      currentScale = 1;
      updateZoomDisplay();

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (viewport) {
        viewport.scrollTop = 0;
        viewport.scrollLeft = 0;
      }
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    cards.forEach((card) => {
      const box = card.querySelector('.img-crop-box');
      box?.addEventListener('click', () => openCardModal(card));
      box?.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          openCardModal(card);
        }
      });
    });

    modalCloseBtn?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    zoomResetBtn?.addEventListener('click', () => {
      isFitMode = true;
      currentScale = 1;
      updateZoomDisplay();
    });

    zoom1to1Btn?.addEventListener('click', () => {
      isFitMode = false;
      currentScale = 1;
      updateZoomDisplay();
    });

    zoomInBtn?.addEventListener('click', () => {
      if (isFitMode) {
        isFitMode = false;
        currentScale = 1.25;
      } else {
        currentScale = Math.min(3, +(currentScale + 0.25).toFixed(2));
      }
      updateZoomDisplay();
    });

    zoomOutBtn?.addEventListener('click', () => {
      if (isFitMode) return;
      currentScale = Math.max(0.5, +(currentScale - 0.25).toFixed(2));
      if (currentScale <= 0.75) {
        isFitMode = true;
        currentScale = 1;
      }
      updateZoomDisplay();
    });

    viewport?.addEventListener(
      'wheel',
      (e) => {
        if (!modal.classList.contains('is-open')) return;
        e.preventDefault();
        if (e.deltaY < 0) {
          if (isFitMode) {
            isFitMode = false;
            currentScale = 1.15;
          } else {
            currentScale = Math.min(3, +(currentScale + 0.15).toFixed(2));
          }
        } else {
          if (isFitMode) return;
          currentScale = Math.max(0.5, +(currentScale - 0.15).toFixed(2));
          if (currentScale <= 0.8) {
            isFitMode = true;
            currentScale = 1;
          }
        }
        updateZoomDisplay();
      },
      { passive: false }
    );

    viewport?.addEventListener('mousedown', (e) => {
      if (!modal.classList.contains('is-open') || e.button !== 0) return;
      isDragging = true;
      startX = e.pageX - viewport.offsetLeft;
      startY = e.pageY - viewport.offsetTop;
      scrollLeft = viewport.scrollLeft;
      scrollTop = viewport.scrollTop;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    viewport?.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - viewport.offsetLeft;
      const y = e.pageY - viewport.offsetTop;
      viewport.scrollLeft = scrollLeft - (x - startX) * 1.3;
      viewport.scrollTop = scrollTop - (y - startY) * 1.3;
    });
  }

  document.addEventListener('astro:page-load', setupEvidenceGallery);
  setupEvidenceGallery();
</script>

<style>
  .gallery-head-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .gallery-sub {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .gallery-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .g-pill {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.8rem;
    padding: 0.38rem 0.8rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .g-pill:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .g-pill.is-active {
    background: rgba(124, 255, 178, 0.14);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 700;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.15rem;
  }

  .evidence-thumb-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
    contain: inline-size;
  }

  .thumb-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .thumb-title-col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .thumb-name {
    font-weight: 700;
    font-size: 0.96rem;
    color: #ffffff;
  }

  .thumb-sub-title {
    font-size: 0.76rem;
    color: var(--text-soft);
    line-height: 1.35;
  }

  .thumb-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    background: rgba(124, 255, 178, 0.1);
    border: 1px solid rgba(124, 255, 178, 0.28);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .img-crop-box {
    position: relative;
    height: 195px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #06070a;
    cursor: pointer;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease;
    user-select: none;
  }

  .evidence-thumb-card:hover .thumb-img {
    transform: scale(1.04);
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: rgba(9, 11, 16, 0.62);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .evidence-thumb-card:hover .img-overlay {
    opacity: 1;
  }

  .view-btn {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #090b10;
    background: var(--accent);
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .thumb-caption {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .thumb-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.74rem;
    padding-top: 0.55rem;
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    gap: 0.5rem;
  }

  .test-date-lbl {
    font-family: var(--font-mono);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .foot-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .link-review,
  .link-aff {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.74rem;
  }

  .link-aff {
    color: var(--text);
  }

  .link-review:hover,
  .link-aff:hover {
    text-decoration: underline;
    color: var(--accent);
  }

  /* Modal */
  .evidence-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .evidence-modal.is-open {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    z-index: 10;
    max-width: 95vw;
    width: 1200px;
    height: 92vh;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
  }

  .modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    flex-shrink: 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .mhead-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .mtitle {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .mdate {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }

  .modal-toolbar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .tool-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .tool-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(124, 255, 178, 0.08);
  }

  .tool-btn.aff-btn {
    background: var(--accent);
    color: #090b10;
    font-weight: 700;
    border-color: var(--accent);
  }

  .modal-close-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-left: 0.25rem;
  }

  .modal-viewport {
    flex: 1;
    position: relative;
    overflow: auto;
    background: #06070a;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }

  .modal-img-container {
    padding: 1rem;
    display: flex;
    justify-content: center;
  }

  .modal-img-container img {
    border-radius: 6px;
    background: #0f131a;
  }

  .modal-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 1rem;
    background: var(--surface-2);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    flex-shrink: 0;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
