---
import { airportsData } from '../../data/airports';
---

<div class="evidence-gallery-box flux-card">
  <div class="gallery-header">
    <div class="gallery-title-wrap">
      <span class="signal-dot breathing"></span>
      <h3 class="gallery-title">16 家机场节点测速实测证据库 (2026-08 批次)</h3>
    </div>
    <span class="gallery-badge">100% UNTOUCHED EVIDENCE</span>
  </div>

  <p class="gallery-desc">
    所有测速图均源自 2026-08-11 批次对 16 家推广机场进行的 MAI-TEST / 喵速多并发测速原始截图。点击任意卡片即可进入<strong>高清交互式画廊</strong>，支持<strong>鼠标按住拖动平移、滚轮缩放、全屏查看</strong>。
  </p>

  <div class="evidence-grid">
    {airportsData.map(airport => (
      <div
        class="evidence-thumb-card flux-card"
        data-img={airport.speedtestImage}
        data-name={airport.name}
        data-date={airport.speedtestDate}
        data-aff={airport.officialUrl}
      >
        <div class="thumb-top">
          <span class="thumb-name">{airport.name}</span>
          <span class="thumb-tag">{airport.lineType}</span>
        </div>
        <div class="img-crop-box">
          <img src={airport.speedtestImage} alt={`${airport.name} 节点测速实测图`} loading="lazy" class="thumb-img" draggable="false" />
          <div class="img-overlay">
            <span class="view-btn">🔍 交互拖拽查看</span>
          </div>
        </div>
        <div class="thumb-foot">
          <span class="test-date-lbl">实测: {airport.speedtestDate}</span>
          <a href={airport.officialUrl} target="_blank" rel="noopener noreferrer" class="link-aff">官网 →</a>
        </div>
      </div>
    ))}
  </div>

  <!-- Interactive Pan & Zoom Lightbox Modal -->
  <div id="evidence-modal" class="evidence-modal" aria-hidden="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-content flux-card" id="modal-content-box">
      <!-- Modal Header with Controls -->
      <div class="modal-head">
        <div class="mhead-title-wrap">
          <span class="signal-dot"></span>
          <h4 id="modal-title" class="mtitle">测速实测证据</h4>
          <span id="modal-date" class="mdate"></span>
        </div>

        <!-- Zoom & Action Toolbar -->
        <div class="modal-toolbar">
          <button type="button" class="tool-btn" id="btn-zoom-in" title="放大 (按键 +)">＋ 放大</button>
          <button type="button" class="tool-btn" id="btn-zoom-out" title="缩小 (按键 -)">－ 缩小</button>
          <button type="button" class="tool-btn" id="btn-zoom-reset" title="还原 100%">↺ 还原</button>
          <button type="button" class="tool-btn" id="btn-fit-width" title="适应宽度">⛶ 适宽</button>
          <a id="modal-aff-link" href="#" target="_blank" rel="noopener noreferrer" class="tool-btn aff-btn">前往官网 →</a>
          <button type="button" class="modal-close-btn" id="modal-close" aria-label="关闭">&times;</button>
        </div>
      </div>

      <!-- Drag / Pan Viewport -->
      <div class="modal-viewport" id="modal-viewport">
        <div class="modal-drag-wrapper" id="modal-drag-wrapper">
          <img
            id="modal-full-img"
            src=""
            alt="完整节点测速图"
            class="modal-img-display"
            draggable="false"
          />
        </div>
      </div>

      <!-- Modal Bottom Tips Bar -->
      <div class="modal-footer-tips">
        <span>💡 操作提示：按住鼠标左键可<strong>自由拖拽平移图片</strong>；滚动鼠标滚轮或点击上方按钮可<strong>无级缩放</strong>；按 <kbd>Esc</kbd> 退出。</span>
        <span id="zoom-level-indicator" class="zoom-indicator">100%</span>
      </div>
    </div>
  </div>
</div>

<style>
  .evidence-gallery-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    margin: 2.5rem 0;
  }

  .gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .gallery-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gallery-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .gallery-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    background: rgba(124, 255, 178, 0.08);
    border: 1px solid rgba(124, 255, 178, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .gallery-desc {
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .gallery-desc strong {
    color: var(--accent);
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .evidence-thumb-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .evidence-thumb-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .thumb-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .thumb-name {
    font-weight: 700;
    color: #ffffff;
    font-size: 0.95rem;
  }

  .thumb-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent-blue);
    background: rgba(114, 167, 255, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .img-crop-box {
    position: relative;
    width: 100%;
    height: 180px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease;
    user-select: none;
  }

  .evidence-thumb-card:hover .thumb-img {
    transform: scale(1.05);
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: rgba(9, 11, 16, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .evidence-thumb-card:hover .img-overlay {
    opacity: 1;
  }

  .view-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #090b10;
    background: var(--accent);
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .thumb-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .test-date-lbl {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .link-aff {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .link-aff:hover {
    text-decoration: underline;
  }

  /* Full Screen Lightbox Modal */
  .evidence-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .evidence-modal.is-open {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    z-index: 10;
    max-width: 95vw;
    width: 1200px;
    height: 92vh;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
  }

  /* Header */
  .modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    flex-shrink: 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .mhead-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mtitle {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .mdate {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .modal-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tool-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .tool-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(124, 255, 178, 0.08);
  }

  .tool-btn.aff-btn {
    background: var(--accent);
    color: #090b10;
    font-weight: 700;
    border-color: var(--accent);
  }

  .tool-btn.aff-btn:hover {
    background: #95ffc2;
    color: #090b10;
  }

  .modal-close-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-left: 0.25rem;
    transition: all 0.15s ease;
  }

  .modal-close-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--border);
  }

  /* Pan & Zoom Viewport */
  .modal-viewport {
    flex: 1;
    position: relative;
    overflow: auto;
    background: #06070a;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }

  .modal-viewport.is-dragging {
    cursor: grabbing;
  }

  .modal-drag-wrapper {
    position: relative;
    transform-origin: top center;
    transition: transform 0.05s ease-out;
    padding: 2rem 1rem;
    display: inline-block;
  }

  .modal-img-display {
    max-width: 900px;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
    display: block;
    user-select: none;
    pointer-events: none; /* Let drag events hit the wrapper/viewport */
  }

  /* Footer tips */
  .modal-footer-tips {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.25rem;
    background: var(--surface-2);
    border-top: 1px solid var(--border);
    font-size: 0.76rem;
    color: var(--text-soft);
    flex-shrink: 0;
  }

  .modal-footer-tips strong {
    color: var(--accent);
  }

  .modal-footer-tips kbd {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .zoom-indicator {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 700;
  }

  @media (max-width: 1200px) {
    .evidence-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .evidence-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .modal-content {
      max-width: 100vw;
      height: 98vh;
      border-radius: var(--radius-md);
    }
    .modal-toolbar {
      width: 100%;
      justify-content: flex-end;
    }
  }

  @media (max-width: 540px) {
    .evidence-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupEvidenceGallery() {
    const cards = document.querySelectorAll<HTMLElement>('.evidence-thumb-card');
    const modal = document.getElementById('evidence-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const viewport = document.getElementById('modal-viewport');
    const dragWrapper = document.getElementById('modal-drag-wrapper');
    const fullImg = document.getElementById('modal-full-img') as HTMLImageElement | null;
    const modalTitle = document.getElementById('modal-title');
    const modalDate = document.getElementById('modal-date');
    const modalAffLink = document.getElementById('modal-aff-link') as HTMLAnchorElement | null;
    const zoomIndicator = document.getElementById('zoom-level-indicator');

    const btnZoomIn = document.getElementById('btn-zoom-in');
    const btnZoomOut = document.getElementById('btn-zoom-out');
    const btnZoomReset = document.getElementById('btn-zoom-reset');
    const btnFitWidth = document.getElementById('btn-fit-width');

    let scale = 1.0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let scrollLeft = 0;
    let scrollTop = 0;

    function updateTransform() {
      if (!dragWrapper) return;
      dragWrapper.style.transform = `scale(${scale})`;
      if (zoomIndicator) {
        zoomIndicator.textContent = `${Math.round(scale * 100)}%`;
      }
    }

    function openModal(imgSrc: string, name: string, date: string, affUrl: string) {
      if (!modal || !fullImg) return;
      fullImg.src = imgSrc;
      scale = 1.0;
      updateTransform();

      if (modalTitle) modalTitle.textContent = `${name} - 节点测速实测证据`;
      if (modalDate) modalDate.textContent = `测试时间: ${date}`;
      if (modalAffLink) {
        modalAffLink.href = affUrl;
        modalAffLink.textContent = `前往 ${name} 官网 →`;
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      if (viewport) {
        viewport.scrollTop = 0;
        viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Drag-to-pan logic on Viewport
    if (viewport) {
      viewport.addEventListener('mousedown', (e) => {
        // Only left click
        if (e.button !== 0) return;
        isDragging = true;
        viewport.classList.add('is-dragging');
        startX = e.pageX - viewport.offsetLeft;
        startY = e.pageY - viewport.offsetTop;
        scrollLeft = viewport.scrollLeft;
        scrollTop = viewport.scrollTop;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        viewport.classList.remove('is-dragging');
      });

      viewport.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - viewport.offsetLeft;
        const y = e.pageY - viewport.offsetTop;
        const walkX = (x - startX) * 1.5;
        const walkY = (y - startY) * 1.5;
        viewport.scrollLeft = scrollLeft - walkX;
        viewport.scrollTop = scrollTop - walkY;
      });

      // Touch drag for mobile
      let touchStartX = 0;
      let touchStartY = 0;
      let touchScrollLeft = 0;
      let touchScrollTop = 0;

      viewport.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].pageX - viewport.offsetLeft;
          touchStartY = e.touches[0].pageY - viewport.offsetTop;
          touchScrollLeft = viewport.scrollLeft;
          touchScrollTop = viewport.scrollTop;
        }
      }, { passive: true });

      viewport.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) {
          const x = e.touches[0].pageX - viewport.offsetLeft;
          const y = e.touches[0].pageY - viewport.offsetTop;
          viewport.scrollLeft = touchScrollLeft - (x - touchStartX);
          viewport.scrollTop = touchScrollTop - (y - touchStartY);
        }
      }, { passive: true });

      // Wheel Zoom
      viewport.addEventListener('wheel', (e) => {
        if (e.ctrlKey || e.metaKey || e.altKey) {
          e.preventDefault();
          const delta = e.deltaY > 0 ? -0.1 : 0.1;
          scale = Math.min(Math.max(0.4, scale + delta), 2.5);
          updateTransform();
        }
      }, { passive: false });
    }

    // Zoom Buttons
    btnZoomIn?.addEventListener('click', () => {
      scale = Math.min(2.5, scale + 0.2);
      updateTransform();
    });

    btnZoomOut?.addEventListener('click', () => {
      scale = Math.max(0.4, scale - 0.2);
      updateTransform();
    });

    btnZoomReset?.addEventListener('click', () => {
      scale = 1.0;
      updateTransform();
      if (viewport) {
        viewport.scrollTop = 0;
        viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
      }
    });

    btnFitWidth?.addEventListener('click', () => {
      if (viewport && fullImg) {
        const availableWidth = viewport.clientWidth - 40;
        scale = Math.min(1.2, availableWidth / 900);
        updateTransform();
      }
    });

    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName.toLowerCase() === 'a') return;
        const imgSrc = card.getAttribute('data-img') || '';
        const name = card.getAttribute('data-name') || '';
        const date = card.getAttribute('data-date') || '';
        const affUrl = card.getAttribute('data-aff') || '#';
        openModal(imgSrc, name, date, affUrl);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
      if (modal?.classList.contains('is-open')) {
        if (e.key === '+' || e.key === '=') {
          scale = Math.min(2.5, scale + 0.2);
          updateTransform();
        } else if (e.key === '-' || e.key === '_') {
          scale = Math.max(0.4, scale - 0.2);
          updateTransform();
        } else if (e.key === '0') {
          scale = 1.0;
          updateTransform();
        }
      }
    });
  }

  setupEvidenceGallery();
  document.addEventListener('astro:page-load', setupEvidenceGallery);
</script>
