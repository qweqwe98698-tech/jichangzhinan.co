---
import { airportsData, deepReviewAirports, totalAirportsCount, type AirportItem } from '../../data/airports';

const lineTypes = ['全部', 'IEPL 专线', 'IPLC 纯专线', '企业级内网专线', '三网优化专线', 'BGP 优质中继'];
const tiers: { label: string; value: string }[] = [
  { label: '全部档位', value: 'all' },
  { label: '旗舰专线 (Flagship)', value: 'Flagship' },
  { label: '高性价比 (HighValue)', value: 'HighValue' },
  { label: '按量不限时 (OnDemand)', value: 'OnDemand' },
  { label: '便宜入门 (Budget)', value: 'Budget' },
  { label: '企业独享 (Enterprise)', value: 'Enterprise' }
];

const measuredCount = deepReviewAirports.length;
const vendorCount = airportsData.filter((a) => a.dataStatus === 'vendor').length;
const historicCount = airportsData.filter((a) => a.dataStatus === 'historic').length;

const dataStatusLabel: Record<AirportItem['dataStatus'], string> = {
  measured: '实测证据',
  vendor: '厂商口径',
  historic: '历史档案'
};

const tierNameMap: Record<AirportItem['tier'], string> = {
  Flagship: '旗舰专线',
  HighValue: '高性价比',
  OnDemand: '按量不限时',
  Budget: '便宜入门',
  Enterprise: '企业极速'
};
---

<div class="finder-box flux-card" id="airport-finder-root">
  <div class="finder-header">
    <div class="finder-title-wrap">
      <span class="signal-dot breathing"></span>
      <h2 class="finder-title">2026 优质机场多维筛选矩阵 ({totalAirportsCount} 品牌库 · {measuredCount} 家实测)</h2>
    </div>
    <span class="finder-status-tag">
      {measuredCount} MEASURED // {vendorCount} VENDOR // {historicCount} HISTORIC
    </span>
  </div>

  <p class="finder-desc">
    全站完整收录 <strong>{totalAirportsCount} 家机场品牌</strong>，严格区分口径：前 10 位按编辑部主推序列置顶；其中 <strong>{measuredCount} 家配有真实测速图/解锁图（可点进独立深度评测页）</strong>，其余 {vendorCount} 家标注官方口径、{historicCount} 家保留历史档案以防混淆。
  </p>

  <!-- Search + Multi-Facet Controls -->
  <div class="finder-controls">
    <div class="search-row">
      <label for="airport-keyword-search" class="sr-only">按品牌名、协议、节点地区或特性搜索机场</label>
      <div class="search-input-wrap">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          id="airport-keyword-search"
          class="keyword-input"
          placeholder="搜索品牌名、协议（VLESS / Hysteria2 / SS）、地区、优惠码或特性..."
          autocomplete="off"
        />
      </div>
      <div class="match-counter">
        当前匹配 <strong id="finder-match-count">{totalAirportsCount}</strong> / {totalAirportsCount} 家
      </div>
      <button type="button" id="finder-reset-btn" class="reset-btn">重置筛选</button>
    </div>

    <div class="filter-group">
      <span class="filter-label">数据口径与特性:</span>
      <div class="filter-pills" data-filter-group="scope">
        <button type="button" class="fpill is-active" data-val="all">全部 {totalAirportsCount} 家</button>
        <button type="button" class="fpill" data-val="measured">有测速/解锁实测 ({measuredCount})</button>
        <button type="button" class="fpill" data-val="topten">Top 10 主推</button>
        <button type="button" class="fpill" data-val="unlimited">含永久/不限时包</button>
        <button type="button" class="fpill" data-val="thirdparty">支持 Clash 第三方订阅</button>
        <button type="button" class="fpill" data-val="historic">历史档案库 ({historicCount})</button>
      </div>
    </div>

    <div class="filter-group">
      <span class="filter-label">线路架构:</span>
      <div class="filter-pills" data-filter-group="line">
        {lineTypes.map((lt, idx) => (
          <button
            type="button"
            class={`fpill ${idx === 0 ? 'is-active' : ''}`}
            data-val={lt === '全部' ? 'all' : lt}
          >
            {lt}
          </button>
        ))}
      </div>
    </div>

    <div class="filter-row-split">
      <div class="filter-group">
        <span class="filter-label">核心场景:</span>
        <div class="filter-pills" data-filter-group="scenario">
          <button type="button" class="fpill is-active" data-val="all">全部场景</button>
          <button type="button" class="fpill" data-val="chatgpt">ChatGPT / Claude AI</button>
          <button type="button" class="fpill" data-val="netflix">Netflix / 4K 流媒体</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">预算档位:</span>
        <div class="filter-pills" data-filter-group="tier">
          {tiers.map((t, idx) => (
            <button
              type="button"
              class={`fpill ${idx === 0 ? 'is-active' : ''}`}
              data-val={t.value}
            >
              {t.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 42-Brand Card Matrix -->
  <div class="airport-cards-grid" id="airport-matrix-grid">
    {airportsData.map((airport) => {
      const hasExternalUrl = /^https?:\/\//i.test(airport.officialUrl);
      const supportsThirdParty = airport.supportsThirdPartySub !== false;
      const evCount = airport.evidenceImages?.length || (airport.speedtestImage ? 1 : 0);
      const searchBlob = [
        airport.name,
        airport.tagline,
        airport.lineType,
        airport.protocols.join(' '),
        airport.features.join(' '),
        airport.nodeCoverage || '',
        airport.recommendedFor,
        airport.discountCode || ''
      ]
        .join(' ')
        .toLowerCase();

      return (
        <article
          id={`airport-${airport.id}`}
          class={`airport-matrix-card flux-card status-${airport.dataStatus}`}
          data-line={airport.lineType}
          data-tier={airport.tier}
          data-status={airport.dataStatus}
          data-topten={airport.isTopTen ? 'true' : 'false'}
          data-unlimited={airport.hasUnlimitedPlan ? 'true' : 'false'}
          data-thirdparty={supportsThirdParty ? 'true' : 'false'}
          data-chatgpt={airport.aiUnlock.chatgpt ? 'true' : 'false'}
          data-netflix={airport.streamingUnlock.netflix ? 'true' : 'false'}
          data-search={searchBlob}
        >
          <!-- Card Top Header -->
          <div class="card-top-row">
            <div class="rank-name-wrap">
              <span class={`rank-num ${airport.isTopTen ? 'top10' : ''}`}>
                #{String(airport.rankOrder).padStart(2, '0')}
              </span>
              <h3 class="airport-card-name">
                {airport.hasDeepReview ? (
                  <a href={`/airports/${airport.slug}/`} class="name-link">
                    {airport.name}
                  </a>
                ) : (
                  <span>{airport.name}</span>
                )}
              </h3>
            </div>

            <div class="card-badges">
              {airport.isTopTen && <span class="mini-badge top">TOP 10</span>}
              <span class={`mini-badge status-${airport.dataStatus}`}>
                {dataStatusLabel[airport.dataStatus]}
                {evCount > 0 ? ` (${evCount}图)` : ''}
              </span>
            </div>
          </div>

          <p class="airport-tagline">{airport.tagline}</p>

          <!-- Key Metrics Strip -->
          <div class="card-metrics-strip">
            <div class="cm-cell">
              <span class="cm-lbl">起步价</span>
              <strong class="cm-val price">{airport.startingPrice}</strong>
            </div>
            <div class="cm-cell">
              <span class="cm-lbl">月流量</span>
              <strong class="cm-val">{airport.monthlyTraffic}</strong>
            </div>
            <div class="cm-cell">
              <span class="cm-lbl">线路/档位</span>
              <strong class="cm-val">{tierNameMap[airport.tier]}</strong>
            </div>
            <div class="cm-cell">
              <span class="cm-lbl">创立/评分</span>
              <strong class="cm-val">{airport.openedYear} · {airport.ratingScore.toFixed(1)}</strong>
            </div>
          </div>

          <!-- Protocols & Unlocks -->
          <div class="card-tags-row">
            <span class="line-tag">{airport.lineType}</span>
            {airport.protocols.slice(0, 3).map((proto) => (
              <span class="feature-tag">{proto}</span>
            ))}
            {airport.hasUnlimitedPlan && <span class="feature-tag accent-soft">含永久不限时</span>}
            {!supportsThirdParty && <span class="feature-tag warn-soft">无第三方订阅</span>}
          </div>

          <div class="unlock-mini-bar">
            <span class={airport.aiUnlock.chatgpt ? 'um ok' : 'um muted'}>
              ChatGPT {airport.aiUnlock.chatgpt ? '✓' : '△'}
            </span>
            <span class={airport.aiUnlock.claude ? 'um ok' : 'um muted'}>
              Claude {airport.aiUnlock.claude ? '✓' : '△'}
            </span>
            <span class={airport.streamingUnlock.netflix ? 'um ok' : 'um muted'}>
              Netflix {airport.streamingUnlock.netflix ? '✓' : '△'}
            </span>
            {airport.discountCode && (
              <span class="um promo">码: {airport.discountCode}</span>
            )}
          </div>

          <p class="recommended-line">
            <strong>适用人群：</strong>{airport.recommendedFor}
          </p>

          <!-- Expandable Package & Risk Details -->
          <details class="card-details-box">
            <summary class="details-summary">
              <span>展开套餐档位{airport.packages ? ` (${airport.packages.length} 档)` : ''}与优缺点/风控详情</span>
              <span class="details-chev" aria-hidden="true">▾</span>
            </summary>
            <div class="details-body">
              {airport.nodeCoverage && (
                <p class="detail-line"><strong>节点覆盖：</strong>{airport.nodeCoverage}</p>
              )}
              {airport.discountActivity && (
                <p class="detail-line"><strong>优惠活动：</strong>{airport.discountActivity}</p>
              )}
              <p class="detail-line">
                <strong>客户端与支付：</strong>{airport.clientMode || airport.clientSupport.join(' / ')} · {airport.paymentMethods.join(' / ')}
              </p>

              {airport.packages && airport.packages.length > 0 && (
                <div class="mini-table-wrap">
                  <table class="mini-pkg-table">
                    <thead>
                      <tr>
                        <th>套餐</th>
                        <th>价格</th>
                        <th>流量</th>
                        <th>周期</th>
                      </tr>
                    </thead>
                    <tbody>
                      {airport.packages.map((pkg) => (
                        <tr>
                          <td>{pkg.name}</td>
                          <td class="mp-price">{pkg.price}</td>
                          <td>{pkg.traffic}</td>
                          <td>{pkg.cycle}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {airport.pros && airport.pros.length > 0 && (
                <p class="detail-line ok-line"><strong>主要亮点：</strong>{airport.pros.join('；')}</p>
              )}
              {airport.risks && airport.risks.length > 0 && (
                <p class="detail-line warn-line"><strong>注意点/局限：</strong>{airport.risks.join('；')}</p>
              )}
              {airport.peerDifference && (
                <p class="detail-line"><strong>横向差异：</strong>{airport.peerDifference}</p>
              )}
              {airport.isUrlFormatAlert && (
                <p class="detail-line warn-line">
                  <strong>链接提示：</strong>该品牌原始跳转地址格式与常规面板不同，访问时请仔细核对域名。
                </p>
              )}
            </div>
          </details>

          <!-- Action Footer -->
          <div class="card-action-footer">
            {hasExternalUrl ? (
              <a
                href={airport.officialUrl}
                target="_blank"
                rel="nofollow sponsored noopener noreferrer"
                class="action-btn primary"
              >
                直达 {airport.name} 官网 ↗
              </a>
            ) : (
              <a href="#methodology" class="action-btn muted-btn">
                暂无独立外链 · 档案核验说明
              </a>
            )}

            {airport.hasDeepReview ? (
              <a href={`/airports/${airport.slug}/`} class="action-btn outline">
                实测深度评测 ({evCount}图) →
              </a>
            ) : (
              <a href="#airport-compare" class="action-btn outline compare-jump" data-compare-id={airport.id}>
                加入参数 PK
              </a>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <!-- Empty Filter State -->
  <div id="finder-empty-state" class="empty-filter-state" hidden>
    <p>没有同时符合当前筛选条件的机场品牌（当前共收录 {totalAirportsCount} 家）。</p>
    <button type="button" id="empty-reset-btn" class="reset-btn">清空所有筛选条件</button>
  </div>
</div>

<script>
  function setupAirportFinder() {
    const root = document.getElementById('airport-finder-root');
    if (!root || root.dataset.finderBound === 'true') return;
    root.dataset.finderBound = 'true';

    const searchInput = document.getElementById('airport-keyword-search') as HTMLInputElement | null;
    const matchCountEl = document.getElementById('finder-match-count');
    const emptyStateEl = document.getElementById('finder-empty-state');
    const resetBtn = document.getElementById('finder-reset-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const cards = Array.from(root.querySelectorAll('.airport-matrix-card')) as HTMLElement[];

    const state = {
      scope: 'all',
      line: 'all',
      scenario: 'all',
      tier: 'all',
      query: ''
    };

    function applyFilters() {
      let visibleCount = 0;
      const q = state.query.trim().toLowerCase();

      cards.forEach((card) => {
        const line = card.dataset.line || '';
        const tier = card.dataset.tier || '';
        const status = card.dataset.status || '';
        const isTopTen = card.dataset.topten === 'true';
        const hasUnlimited = card.dataset.unlimited === 'true';
        const supportsThirdParty = card.dataset.thirdparty === 'true';
        const hasChatGPT = card.dataset.chatgpt === 'true';
        const hasNetflix = card.dataset.netflix === 'true';
        const searchBlob = card.dataset.search || '';

        let matchScope = true;
        if (state.scope === 'measured') matchScope = status === 'measured';
        else if (state.scope === 'topten') matchScope = isTopTen;
        else if (state.scope === 'unlimited') matchScope = hasUnlimited;
        else if (state.scope === 'thirdparty') matchScope = supportsThirdParty;
        else if (state.scope === 'historic') matchScope = status === 'historic';

        const matchLine = state.line === 'all' || line === state.line;
        const matchTier = state.tier === 'all' || tier === state.tier;
        const matchScenario =
          state.scenario === 'all' ||
          (state.scenario === 'chatgpt' && hasChatGPT) ||
          (state.scenario === 'netflix' && hasNetflix);
        const matchQuery = !q || searchBlob.includes(q);

        const isVisible = matchScope && matchLine && matchTier && matchScenario && matchQuery;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (matchCountEl) matchCountEl.textContent = String(visibleCount);
      if (emptyStateEl) emptyStateEl.hidden = visibleCount > 0;
    }

    function resetAll() {
      state.scope = 'all';
      state.line = 'all';
      state.scenario = 'all';
      state.tier = 'all';
      state.query = '';
      if (searchInput) searchInput.value = '';

      root.querySelectorAll('.filter-pills').forEach((group) => {
        const btns = group.querySelectorAll('.fpill');
        btns.forEach((b, idx) => {
          b.classList.toggle('is-active', idx === 0);
        });
      });

      applyFilters();
    }

    root.querySelectorAll('.filter-pills').forEach((groupEl) => {
      const groupName = groupEl.getAttribute('data-filter-group') as 'scope' | 'line' | 'scenario' | 'tier' | null;
      if (!groupName) return;

      groupEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.fpill') as HTMLElement | null;
        if (!btn) return;
        const val = btn.dataset.val || 'all';
        state[groupName] = val;

        groupEl.querySelectorAll('.fpill').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      state.query = searchInput.value;
      applyFilters();
    });

    resetBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);

    // Optional quick PK jump preselect
    root.querySelectorAll('.compare-jump').forEach((link) => {
      link.addEventListener('click', () => {
        const id = (link as HTMLElement).dataset.compareId;
        const selA = document.getElementById('compare-brand-a') as HTMLSelectElement | null;
        if (selA && id) {
          selA.value = id;
          selA.dispatchEvent(new Event('change'));
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupAirportFinder);
  setupAirportFinder();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .finder-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-bottom: 3rem;
  }

  .finder-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .finder-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .finder-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .finder-status-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    background: rgba(124, 255, 178, 0.08);
    border: 1px solid rgba(124, 255, 178, 0.28);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .finder-desc {
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 1.4rem;
  }

  .finder-controls {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.15rem;
    background: rgba(9, 11, 16, 0.55);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .search-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .search-input-wrap {
    flex: 1;
    min-width: 240px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--muted);
    font-size: 1rem;
    pointer-events: none;
  }

  .keyword-input {
    width: 100%;
    padding: 0.62rem 0.9rem 0.62rem 2.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: 0.88rem;
    outline: none;
  }

  .keyword-input:focus {
    border-color: var(--accent);
  }

  .match-counter {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-soft);
  }

  .match-counter strong {
    color: var(--accent);
    font-size: 0.92rem;
  }

  .reset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.78rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .reset-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .filter-row-split {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.75rem;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    min-width: 82px;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .fpill {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.78rem;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .fpill:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .fpill.is-active {
    background: rgba(124, 255, 178, 0.14);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 700;
  }

  .airport-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 1.15rem;
  }

  .airport-matrix-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.78rem;
    min-width: 0;
    contain: inline-size;
  }

  .airport-matrix-card.status-historic {
    border-color: rgba(255, 255, 255, 0.08);
    opacity: 0.94;
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .rank-name-wrap {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .rank-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.18rem 0.45rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .rank-num.top10 {
    color: #090b10;
    background: var(--accent);
  }

  .airport-card-name {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }

  .name-link {
    color: #ffffff;
    text-decoration: none;
  }

  .name-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-end;
