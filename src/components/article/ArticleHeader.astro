---
import Badge from '../ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  categoryName?: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  difficulty: string;
  readingTime: string;
  keyProblems?: string[];
}

const {
  title,
  description,
  category,
  categoryName,
  pubDate,
  updatedDate,
  author,
  difficulty,
  readingTime,
  keyProblems = []
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(new Date(updatedDate || pubDate));
---

<header class="article-hero-header" data-reveal>
  <!-- Category & Breadcrumb Tag -->
  <div class="header-badge-row">
    <a href={`/topics/${category}/`} class="category-link">
      <span class="signal-dot"></span>
      <span class="cat-name">{categoryName || category.toUpperCase()}</span>
    </a>
    <Badge variant={difficulty === 'Beginner' ? 'accent' : difficulty === 'Intermediate' ? 'blue' : 'purple'}>
      {difficulty}
    </Badge>
  </div>

  <!-- Title -->
  <h1 class="article-main-title">{title}</h1>

  <!-- Description / Abstract -->
  <p class="article-lead-desc">{description}</p>

  <!-- Meta Information Bar -->
  <div class="article-meta-bar">
    <div class="meta-item">
      <span class="meta-label">AUTHOR</span>
      <span class="meta-val">{author}</span>
    </div>
    <div class="meta-divider"></div>
    <div class="meta-item">
      <span class="meta-label">LAST UPDATED</span>
      <time datetime={new Date(updatedDate || pubDate).toISOString()} class="meta-val">{formattedDate}</time>
    </div>
    <div class="meta-divider"></div>
    <div class="meta-item">
      <span class="meta-label">READ TIME</span>
      <span class="meta-val">{readingTime}</span>
    </div>
  </div>

  <!-- Key Problem Statement (本文解决什么问题？) -->
  {keyProblems && keyProblems.length > 0 && (
    <div class="key-problems-box">
      <div class="box-header">
        <span class="signal-dot breathing"></span>
        <span class="box-title">本文解决什么问题？</span>
      </div>
      <div class="problems-grid">
        {keyProblems.map((prob, idx) => (
          <div class="problem-item">
            <span class="problem-num">{String(idx + 1).padStart(2, '0')}</span>
            <span class="problem-text">{prob}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</header>

<style>
  .article-hero-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.08em;
    background: rgba(124, 255, 178, 0.08);
    border: 1px solid rgba(124, 255, 178, 0.2);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .article-main-title {
    font-size: clamp(2rem, 3.8vw, 2.9rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .article-lead-desc {
    font-size: 1.15rem;
    color: var(--text-soft);
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 920px;
  }

  .article-meta-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .meta-val {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .meta-divider {
    width: 1px;
    height: 28px;
    background: var(--border);
  }

  /* Key Problems Box */
  .key-problems-box {
    background: linear-gradient(145deg, var(--surface) 0%, rgba(22, 26, 35, 0.7) 100%);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: 1.5rem 1.75rem;
    margin-top: 1.5rem;
  }

  .box-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .box-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .problem-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .problem-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.4;
  }

  .problem-text {
    font-size: 0.92rem;
    color: var(--text-soft);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .problems-grid {
      grid-template-columns: 1fr;
    }
    .meta-divider {
      display: none;
    }
    .article-meta-bar {
      gap: 1rem;
    }
  }
</style>
