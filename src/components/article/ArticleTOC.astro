---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="article-toc-wrapper" aria-label="文章目录">
    <div class="toc-header">
      <span class="signal-dot"></span>
      <span class="toc-title">DIRECTORY / 目录</span>
    </div>

    <ul class="toc-list" id="toc-list">
      {filteredHeadings.map(h => (
        <li class={`toc-item depth-${h.depth}`}>
          <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
            <span class="toc-node-bullet">○</span>
            <span class="toc-link-text">{h.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .article-toc-wrapper {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    max-height: calc(100vh - var(--header-height) - 4rem);
    overflow-y: auto;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item.depth-3 {
    padding-left: 0.85rem;
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--text-soft);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s ease;
    padding: 0.2rem 0;
  }

  .toc-node-bullet {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .toc-link:hover {
    color: #ffffff;
  }

  .toc-link.is-active {
    color: var(--accent);
    font-weight: 600;
  }

  .toc-link.is-active .toc-node-bullet {
    color: var(--accent);
  }

  .toc-link-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  function setupTOC() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const slugs = Array.from(tocLinks).map(link => link.getAttribute('data-slug'));
    const headings = slugs
      .map(s => document.getElementById(s!))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length === 0) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach(link => {
            const bullet = link.querySelector('.toc-node-bullet');
            if (link.getAttribute('data-slug') === id) {
              link.classList.add('is-active');
              if (bullet) bullet.textContent = '●';
            } else {
              link.classList.remove('is-active');
              if (bullet) bullet.textContent = '○';
            }
          });
        }
      });
    }, {
      rootMargin: '-80px 0px -70% 0px'
    });

    headings.forEach(h => observer.observe(h));
  }

  setupTOC();
  document.addEventListener('astro:page-load', setupTOC);
</script>
