---
import Badge from '../ui/Badge.astro';

interface Props {
  category: string;
  categoryName?: string;
  tags: string[];
  difficulty: string;
  readingTime: string;
  slug: string;
}

const {
  category,
  categoryName,
  tags = [],
  difficulty,
  readingTime,
  slug
} = Astro.props;
---

<aside class="article-meta-sidebar">
  <!-- Topic & Difficulty Card -->
  <div class="sidebar-card flux-card">
    <div class="card-sec-header">
      <span class="signal-dot"></span>
      <span class="sec-title">TOPIC CLUSTER</span>
    </div>
    
    <div class="cluster-link-row">
      <a href={`/topics/${category}/`} class="cluster-pill">
        <span>{categoryName || category.toUpperCase()}</span>
        <span class="cluster-arrow">→</span>
      </a>
    </div>

    <div class="sidebar-details-list">
      <div class="detail-row">
        <span class="detail-lbl">DIFFICULTY</span>
        <span class="detail-val">{difficulty}</span>
      </div>
      <div class="detail-row">
        <span class="detail-lbl">EST. TIME</span>
        <span class="detail-val">{readingTime}</span>
      </div>
    </div>

    {tags.length > 0 && (
      <div class="tags-section">
        <span class="tags-title">TAGS</span>
        <div class="tags-cloud">
          {tags.map(tag => (
            <span class="tag-chip">#{tag}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Share / Copy Link Action -->
    <div class="sidebar-actions">
      <button class="copy-url-btn" id="copy-article-url" aria-label="复制本文链接">
        <svg viewBox="0 0 20 20" fill="none" class="action-icon">
          <rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M4 13V5a2 2 0 0 1 2-2h8" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span id="copy-btn-text">复制本文链接</span>
      </button>
    </div>
  </div>
</aside>

<style>
  .article-meta-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .sidebar-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-sec-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .sec-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .cluster-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .cluster-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sidebar-details-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .detail-lbl {
    color: var(--muted);
  }

  .detail-val {
    color: var(--text);
    font-weight: 600;
  }

  .tags-section {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .tags-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-soft);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .sidebar-actions {
    padding-top: 0.5rem;
  }

  .copy-url-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.85rem;
    padding: 0.6rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .copy-url-btn:hover {
    background: var(--surface-hover);
    color: #ffffff;
    border-color: var(--border-hover);
  }

  .action-icon {
    width: 16px;
    height: 16px;
  }
</style>

<script>
  function setupCopyBtn() {
    const btn = document.getElementById('copy-article-url');
    const btnText = document.getElementById('copy-btn-text');
    if (!btn || !btnText) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        btnText.textContent = '已复制链接！';
        setTimeout(() => {
          btnText.textContent = '复制本文链接';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }

  setupCopyBtn();
  document.addEventListener('astro:page-load', setupCopyBtn);
</script>
