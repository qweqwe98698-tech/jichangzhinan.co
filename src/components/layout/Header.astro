---
import { siteConfig } from '../../config/site';
import { headerNavLinks } from '../../data/navigation';
import SearchTrigger from '../search/SearchTrigger.astro';

const currentPath = Astro.url.pathname;
---

<header class="flux-header" id="main-header">
  <div class="container header-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label={`${siteConfig.name} - 返回首页`}>
      <span class="signal-dot breathing" aria-hidden="true"></span>
      <span class="logo-text">{siteConfig.logo.text}</span>
      <span class="logo-badge">{siteConfig.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="主导航">
      <ul class="nav-list">
        {headerNavLinks.map(link => {
          const isActive = link.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(link.href);
          return (
            <li class="nav-item">
              <a 
                href={link.href} 
                class={`nav-link ${isActive ? 'is-active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{link.name}</span>
                {link.badge && <span class="nav-badge">{link.badge}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <SearchTrigger />
      
      <!-- Mobile Menu Toggle Button -->
      <button 
        class="mobile-toggle-btn" 
        id="mobile-menu-toggle" 
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .flux-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    z-index: 100;
    background: rgba(9, 11, 16, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .flux-header.is-scrolled {
    background: rgba(9, 11, 16, 0.94);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    color: #ffffff;
  }

  .logo-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0.15rem 0.45rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  /* Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    background: var(--accent);
    color: #090b10;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    margin-left: 0.3rem;
    line-height: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-toggle-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0;
  }

  .hamburger-bar {
    width: 18px;
    height: 2px;
    background-color: var(--text);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle-btn {
      display: flex;
    }
  }
</style>

<script>
  // Header scroll detection
  const header = document.getElementById('main-header');
  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }, { passive: true });
  }
</script>
