---
import Badge from '../ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  category?: string;
  categoryName?: string;
  readingTime?: string;
  badgeText?: string;
  indexNum?: string;
  tags?: string[];
  class?: string;
}

const {
  title,
  description,
  href,
  category = 'GUIDE',
  categoryName,
  readingTime = '10 MIN READ',
  badgeText = 'FEATURED',
  indexNum = '01',
  tags = ['16家真实品牌', 'IEPL纯专线', '晚高峰0丢包', '4K杜比解锁', 'AI原生节点'],
  class: className = ''
} = Astro.props;
---

<article class={`flux-card feature-card ${className}`}>
  <!-- Top Meta Row -->
  <div class="card-top-meta">
    <div class="meta-left">
      <span class="mono-index">{indexNum}</span>
      <Badge variant="accent">{badgeText}</Badge>
    </div>
    <span class="category-pill">{categoryName || category}</span>
  </div>

  <!-- Content Body -->
  <div class="card-body">
    <h3 class="card-title">
      <a href={href} class="title-link">
        {title}
      </a>
    </h3>

    <p class="card-desc">
      {description}
    </p>

    <!-- Highlight Feature Tags -->
    <div class="feature-tags-wrap">
      {tags.slice(0, 5).map(tag => (
        <span class="feature-tag-pill">
          <span class="dot-prefix">•</span>
          {tag}
        </span>
      ))}
    </div>

    <!-- Micro Data Terminal Preview Box (Fills Space with High-Value Context) -->
    <div class="feature-terminal-box">
      <div class="terminal-box-header">
        <span class="term-dot"></span>
        <span class="term-title">2026 BENCHMARK MATRIX // 测评档案</span>
      </div>
      <div class="terminal-specs-grid">
        <div class="term-spec-item">
          <span class="spec-label">实测样本</span>
          <span class="spec-value">16 家主流品牌</span>
        </div>
        <div class="term-spec-item">
          <span class="spec-label">测速证据</span>
          <span class="spec-value highlight-accent">2026-08-11 批次</span>
        </div>
        <div class="term-spec-item">
          <span class="spec-label">重点协议</span>
          <span class="spec-value">VLESS / Hy2 / SS</span>
        </div>
        <div class="term-spec-item">
          <span class="spec-label">梯队划分</span>
          <span class="spec-value">T1 旗舰 ~ T3 平价</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Details -->
  <div class="card-footer">
    <div class="footer-meta">
      <span class="signal-dot"></span>
      <span class="reading-time">{readingTime}</span>
      <span class="read-prompt">· 完整横评与天梯选型</span>
    </div>
    <a href={href} class="card-action-btn" aria-label={`阅读全文：${title}`}>
      <span class="btn-cta-text">阅读全文</span>
      <span class="arrow-icon">↗</span>
    </a>
  </div>

  <!-- Decorative Orbit Track in Background -->
  <div class="card-bg-orbit" aria-hidden="true">
    <svg viewBox="0 0 400 300" fill="none">
      <circle cx="380" cy="50" r="140" stroke="rgba(124, 255, 178, 0.08)" stroke-width="1.2" stroke-dasharray="4 6" />
      <circle cx="380" cy="50" r="80" stroke="rgba(114, 167, 255, 0.06)" stroke-width="1" />
    </svg>
  </div>
</article>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(145deg, var(--surface) 0%, rgba(22, 26, 35, 0.95) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    position: relative;
    padding: 2rem 2.25rem;
    height: 100%;
    min-height: 520px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-card:hover {
    border-color: rgba(124, 255, 178, 0.4);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 35px rgba(124, 255, 178, 0.08);
  }

  .card-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
    position: relative;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mono-index {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--accent);
  }

  .category-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-body {
    margin: 1.25rem 0;
    z-index: 2;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .card-title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .title-link {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .feature-card:hover .title-link {
    color: var(--accent);
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.7;
    margin: 0;
  }

  /* Tag Pills */
  .feature-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-soft);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .dot-prefix {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .feature-card:hover .feature-tag-pill {
    border-color: rgba(124, 255, 178, 0.2);
    background: rgba(124, 255, 178, 0.04);
    color: #ffffff;
  }

  /* Terminal Preview Box */
  .feature-terminal-box {
    background: #0d1117;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    margin-top: 0.25rem;
  }

  .terminal-box-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 0.6rem;
  }

  .term-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .term-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .terminal-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.25rem;
  }

  .term-spec-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
  }

  .spec-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .spec-value {
    color: #ffffff;
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .spec-value.highlight-accent {
    color: var(--accent);
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    z-index: 2;
    position: relative;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .read-prompt {
    color: var(--text-soft);
    font-family: var(--font-sans);
  }

  .card-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-cta-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .arrow-icon {
    font-size: 0.95rem;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .feature-card:hover .card-action-btn {
    background: var(--accent);
    color: #090b10;
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(124, 255, 178, 0.3);
  }

  .feature-card:hover .arrow-icon {
    color: #090b10;
    transform: translate(2px, -2px);
  }

  .card-bg-orbit {
    position: absolute;
    top: 0;
    right: 0;
    width: 260px;
    height: 200px;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .card-bg-orbit svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .feature-card {
      padding: 1.5rem;
    }

    .terminal-specs-grid {
      grid-template-columns: 1fr;
    }

    .read-prompt {
      display: none;
    }
  }
</style>
